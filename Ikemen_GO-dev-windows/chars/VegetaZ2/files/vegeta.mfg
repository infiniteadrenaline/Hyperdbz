;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial

trigger1 = P2DisT x < -12 && StateType = A
trigger2 =  !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = StateNo = 110 || StateNo = 115 || StateNo = 111;5.1
flag = NoAirGuard
ignoreHitPause = 0

;These three state controllers are only used in three siuations: when the character has landed from a jump
;after switching sides (to get around a MUGEN bug where a character's directions don't switch until a
;tick has passed, after they've landed from a jump and switched sides); if one of the control reversing
;explods is active, or if (on a keyboard) two opposite directions are held simultaneously. For the first
;two cases, guarding should still be possible, but in the third, guarding should be disabled. In all other
;situations, MUGEN's default guard behavior works well enough!
     
;The first state controller disables MUGEN's normal guard system if any of of these scenarios occur.
[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0

;===========================================================================
; HYPERS
;===========================================================================

;Air Galactic Gunfire (Rage Mode)
[State -1, air Rage GG]
type = ChangeState
triggerall = !AILevel  
triggerall = var(1) = 1 ;Normal Vegeta only
triggerall = roundstate = 2
triggerall = (var(53)=0 && power >= 3000) || (var(53)>0 && power >= 2000)
;triggerall = (command = "2qcfa") || (command = "2qcfb") || (command = "2qcfc")
triggerall = cond(Facing = 1,(NumExplod(90030016) || NumExplod(90030003)),(NumExplod(90030101) || NumExplod(90030114)))
triggerall = NumExplod(90000230) || NumExplod(90000240) || NumExplod(90000250) || NumExplod(90000235) || NumExplod(90000245) || NumExplod(90000255)
triggerall = statetype = A  && !WinKo
;triggerall = power >= 1000 ;&& var(58) >= 700
triggerall = stateno != 2803
trigger1 = ctrl
trigger2 = stateno=1501 && movecontact=[1,30]
trigger3 = stateno=1551 && movecontact=[1,30]
value = Cond(var(53)=0,2603,2803) ;2803

;Galactic Gunfire (Rage Mode)
[State -1, Rage GG]
type = ChangeState
triggerall = !AILevel  
triggerall = var(1) = 1 ;Normal Vegeta only
triggerall = roundstate = 2
triggerall = var(53)>0
;triggerall = (((command = "2qcfa") || (command = "2qcfb") || (command = "2qcfc")) && NumExplod(20)=0) || (((command = "2qcba") || (command = "2qcbb") || (command = "2qcbc")) && NumExplod(20)=1)
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && (NumExplod(90030016) || NumExplod(90030003))) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && (NumExplod(90030101) || NumExplod(90030114))))
triggerall = NumExplod(90000230) || NumExplod(90000240) || NumExplod(90000250) || NumExplod(90000235) || NumExplod(90000245) || NumExplod(90000255)
triggerall = statetype != A  && !WinKo
triggerall = power >= 2000 ;&& var(58) >= 700
triggerall = stateno != 2800
trigger1 = Ctrl
trigger2 = stateno = 100 || stateno = 101
trigger3 = stateno = 1300 && movecontact  ;Slash Chop
trigger4 = ((stateno = 200) || (stateno = 210) || (stateno = 220) || (stateno = 221) || (stateno = 225)) && movecontact
trigger5 = ((stateno = 230) || (stateno = 240) || (stateno = 241) || (stateno = 242) || (stateno = 250) || (stateno = 258) || (stateno = 256) || (stateno = 257)) && movecontact
trigger6 = ((stateno = 400) || (stateno = 410) || (stateno = 420)) && movecontact
trigger7 = ((stateno = 430) || (stateno = 440)) && movecontact
trigger8 = stateno=1050 && AnimElemTime(3)>=0
trigger9 = stateno = 1120 && movecontact  ; Wolverine Dashing Elbow
value = 2800

;Galactic Gunfire (Normal)
[State -1, GG]
type = ChangeState
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = !AILevel  
triggerall = var(1) = 1 ;Normal Vegeta only
triggerall = roundstate = 2
triggerall = var(53)=0 ;No rage mode
;triggerall = (((command = "2qcfa") || (command = "2qcfb") || (command = "2qcfc")) && NumExplod(20)=0) || (((command = "2qcba") || (command = "2qcbb") || (command = "2qcbc")) && NumExplod(20)=1)
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && (NumExplod(90030016) || NumExplod(90030003))) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && (NumExplod(90030101) || NumExplod(90030114))))
triggerall = NumExplod(90000230) || NumExplod(90000240) || NumExplod(90000250) || NumExplod(90000235) || NumExplod(90000245) || NumExplod(90000255)
triggerall = statetype != A  && !WinKo
triggerall = power >= 3000
triggerall = stateno != 2600
trigger1 = Ctrl
trigger2 = stateno = 100 || stateno = 101
trigger3 = stateno = 1300 && movecontact  ;Slash Chop
trigger4 = ((stateno = 200) || (stateno = 210) || (stateno = 220) || (stateno = 221) || (stateno = 225)) && movecontact
trigger5 = ((stateno = 230) || (stateno = 240) || (stateno = 241) || (stateno = 242) || (stateno = 250) || (stateno = 258) || (stateno = 256) || (stateno = 257)) && movecontact
trigger6 = ((stateno = 400) || (stateno = 410) || (stateno = 420)) && movecontact
trigger7 = ((stateno = 430) || (stateno = 440)) && movecontact
trigger8 = stateno = 1120 && movecontact  ; Wolverine Dashing Elbow
value = 2600

;Air Final Flash
