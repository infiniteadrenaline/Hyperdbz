; Lose by Time Over

[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;===========================================================================
; <<<<< WINPOSES >>>>>
; Winpose Decider : 180
; V/M - Winpose 1 - Laugh or head humph : 181
; V/M - Winpose 2 - James Bond Shooting Screen : 182
; V - Winpose 3 - Turns and hump (Shin Buthouden) : 183
; V - Winpose 4 - Taunt : 184
; M - Winpose 4b - Babidi : 784
; V - Winpose 5 (Perfect) - split dance : 185
; M - Winpose 5b (Perfect) - Hyper Dimension Style: 785 ; was 189 (9)
; V - Winpose 6 - Phone (only for English voices) : 186
; M - Winpose 6b - arms spread: 786
; V - Winpose 7 - Win VS SSJ Goku (only for English voices) : 187
; M - Winpose 7b - Head hurting : 787
; V - Winpose 8 - Saibamen : 188
; M - Winpose 8b - Laughing : 788
; M - Winpose 9 - Turn back : 789
; M - Winpose 10 (SPB 3 Finisher) - Salt Statue: 3841
; M - Winpose 11 - Bakuhatsuha: 3900
; M - Winpose 12 - Babidi Necromancer: 3901
;M- charging evil energy
;M-evil talking
;M- fist shaking

;M-bulma winpose ( cont from intro )
;===========================================================================

; WIN STATE DECIDER
[Statedef 180]
type = S
ctrl = 0

[State 0, VarAdd]
type = VarAdd
trigger1 = MatchOver
fvar(39) = 1

[State 3025, Dragon Ball from opponent]
type = helper
triggerall = !AILEVEL
triggerall = numenemy
triggerall = !((ishometeam = 1)&& (teamside= 1)) 
triggerall = !time
triggerall = MatchOver && !numhelper(18045)
trigger1 = MatchNo = 2
trigger2 = MatchNo = 3
trigger3 = MatchNo = 5
trigger4 = MatchNo = 6
trigger5 = MatchNo = 8
trigger6 = MatchNo = 11
trigger7 = MatchNo = 12
helpertype = normal
stateno = 18045
ID = 18045
name = "Dragon Ball"
postype = p2
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 180, VictoryQuote]
type = victoryquote
trigger1 = !time
value = 50*(var(1)=2)+(random%30)
;value = 50*(var(1)=2)+(random%14)

;[MAJIN]
[State 180, Debug];Debug winpose
type = Null;changestate
trigger1 = !time
value = 3901

;[MAJIN]
[State 180, win by SPB 3];Salt Statue
type = changestate
triggerall = var(1)=2 ; Majin only
trigger1 = !time
trigger1 = NumExplod(3840)
value = 3841

;--------------------

;Bulma Winpose
[State 180, Bulma strikes Back]
type = changestate
trigger1 = var(51)=722 ; Bulma
trigger1 = !time
value = 3920

;[MAJIN]
[State 180, Bakuhatsu Winpose]
type = changestate
triggerall = numenemy
triggerall = enemy, pos Y < 8000
triggerall = var(1)=2 ; Majin only
trigger1 = !time
trigger1 = var(54)=1 ; Baku winpose enabled
value = 3900+(random <= 499)*(enemy,Name != "Babidi Z2")

;--------------------

[State 180, Perfect win];Split Dance/Hyper Dimension
type = changestate
trigger1 = !time
trigger1 = life = lifemax
value = 185 + 600*(var(1)=2)

[State 180, win with fatality]
type = ChangeState
triggerall = numenemy
trigger1 = (enemy,prevstateno = [5941,5943]) || (enemy,prevstateno = 2847)
trigger1 = Time = 0
value = 183

[State 180, win];Win VS SSJ Goku
type = changestate
triggerall = var(1)=1 ; Normal Vegeta only
triggerall = matchover
triggerall = var(55)=0		;Voice=English
triggerall = numenemy
trigger1 = enemy,name="SSJ2 Goku Hyper Demension"
trigger2 = enemy,name="Goku By Hyper"
trigger3 = enemy,name="SSJ2-GOKU by BARDOCK"
trigger4 = enemy,name="super ssj3 goku v2"
trigger5 = enemy,name="SSJ3 Goku"
trigger6 = enemy,name="ss3goku"
trigger7 = enemy,name="Son-Goku-SSJ3"
trigger8 = enemy,name="Super Sayan 3"
trigger9 = enemy,name="GokuSSJ3"
trigger10 = enemy,name="Goku Super Saiyajin"
trigger11 = enemy,name="SSJ Goku" || enemy,name="Goku SSJ"
trigger12 = enemy,name="SSJ2 Goku"
trigger13 = enemy,name="Goku Super Sayajin 2 by ribeiro"
trigger14 = enemy,name="[Necromancer's] Goku"
trigger15 = enemy,name="Goku-SSJ2"
trigger16 = enemy,name="SSJ Goku by Ryon"
trigger17 = enemy,name="Sup. Goku" || enemy,name="Sup.Goku"
trigger18 = enemy,name="Goku Super Sayajin by Roken"
trigger19 = enemy,name="NeoKakaroto"
trigger20 = enemy,name="Son Goku by Duende Macabro"
trigger21 = enemy,name="Goku Legend"
trigger22 = enemy,name="SSJ Goku Z2"
value = 187

[State 180, win];Taunt/Babidi
type = changestate
trigger1 = !time
trigger1 = command="holdstart"
value = 184 + 600*(var(1)=2)

[State 180, Normal Vegeta win]
type = changestate
triggerall = var(1)=1 ; Normal Vegeta only
triggerall = var(55)>=1		;Voice=Japan or Sabbat
trigger1 = !time
trigger1 = command="holdx" || command="holdy" || command="holdz"
value = cond(command="holdz",183,cond(command="holdy" ,188,181))

[State 180, Normal Vegeta win]
type = changestate
triggerall = var(1)=1 ; Normal Vegeta only
triggerall = var(55)=0		;Voice=English
trigger1 = !time
trigger1 = command="holdx" || command="holdy" || command="holdz"
value = cond(command="holdz",183,cond(command="holdy" ,188,186))

[State 180, Normal Vegeta win]
type = changestate
triggerall = var(1)=1 ; Normal Vegeta only
trigger1 = !time
trigger1 = command="holda" || command="holdb" || command="holdc"
value = cond(command="holdc",183,cond(command="holdb",182,181))

[State 180, Majin win]
type = changestate
triggerall = var(1)=2 ; Majin only
trigger1 = !time
trigger1 = command="holdx" || command="holdy" || command="holdz"
value = cond(command="holdz",786,cond(command="holdy" ,182,181))

[State 180, Majin win]
type = changestate
triggerall = var(1)=2 ; Majin only
trigger1 = !time
trigger1 = command="holda" || command="holdb" || command="holdc"
value = cond(command="holdc",789,cond(command="holdb",788,787))


[State 180, Normal Vegeta win]
type = ChangeState
triggerall = var(1)=1 ; Normal Vegeta only
triggerall = var(55)>=1		;Voice=Japan or Sabbat
trigger1 = Time = 0
value = cond(random<200,188, 181+random%4)

[State 180, Normal Vegeta win]
type = ChangeState
triggerall = var(1)=1 ; Normal Vegeta only
triggerall = var(55)=0		;Voice=English
trigger1 = Time = 0
value = cond(random<333,186+2*(random%2), 181+random%4)

[State 180, Majin win]
type = ChangeState
triggerall = var(1)=2 ; Majin only
trigger1 = Time = 0
value =  cond(random<333,181+random%2, 786+random%4)

