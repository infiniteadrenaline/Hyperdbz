[Statedef -2]

[State 0, VarAdd]
type = VarAdd
trigger1 = NumHelper(19875)
trigger1 = fvar(39) <1000
fvar(39) = 3000

;Focus unblockable protection
[State 0, Explod]
type = Explod
trigger1 = NumExplod(5050)<6
trigger1 = P2movetype = H
anim = 15999
ID = 5050
removetime = 5
ignorehitpause = 1


