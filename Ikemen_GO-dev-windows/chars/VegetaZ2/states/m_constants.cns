;fvar(1)  : Cheap KO
;fvar(2)  : Damage Detection variable
;fvar(4)  : aerial ki blast vels
;fvar(5)  : [MAJIN] Enemy Vel X on KO
;fvar(6)  : [MAJIN] Enemy Vel Y on KO
;fvar(8)  : NEW Damage Dampener - Counter Flag
;fvar(9)  : Slash Chop Charging strength
;fvar(10) : NEW Damage Dampener - Range Limit
;fvar(11) : NEW Damage Dampener - Root Dampener
;fvar(12) : ---------------- Damage Dampener -- OLD
