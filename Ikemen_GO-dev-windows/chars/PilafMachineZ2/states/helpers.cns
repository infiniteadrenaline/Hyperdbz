;==========================================================
;Cameo Intro 5: Eggman
[Statedef 19804]
type = A
velset = 0,0
physics = N
sprpriority = 4
anim = stateno
ctrl = 0

[State init vars]
type = null
trigger1 = 1 || var(20) := floor(root,pos y - 80) ;"Floor" point
trigger1 = 1 || var(23) := 3 ;"Float" point
persistent = 0

[State init pos]
type = posadd
trigger1 = 1
y = -300
x = -40
persistent = 0

[State init fall speed]
type = velset
trigger1 = 1
y = 2
persistent = 0

[State stop]
type = velset
trigger1 = pos y >= var(20)
y = 0
persistent = 0


[State stop]
type = posset
trigger1 = pos y >= var(20)
y = var(20)
persistent = 0

[state inc timer]
type = varadd
trigger1 = !var(21) && pos y >= var(20)
trigger2 = var(21)
var(21) = 1

[State move right]
type = velset
trigger1 = var(21) >= 50
trigger1 = 1 || var(22) := 1
trigger1 = 1 || fvar(1) := 0.5
x = 0.5
persistent = 0

[State bob up and down]
type = velset
trigger1 = fvar(1)
y = fvar(1)

[State change yvel]
type = varset
triggerall = var(22)
triggerall = (var(21)-50)%10 = 0
trigger1 = 1 || var(22) := cond(var(22) >0,-1,1);var(22)^-1 ;Flip Bits
fvar(1) = fvar(1)*var(22)

[State flames]
type = explod
trigger1 = var(21) >= 50
id = stateno
anim = 198040
sprpriority = 3
postype = P1
pos = 0,0
shadow = 0,0,0
removetime = -1
bindtime = -1
persistent = 0

[State stop moving right]
type = posset
trigger1 = facing = 1 && (pos x >= root,pos x)
trigger2 = facing = -1 && (pos x <= root,pos x)
x = floor(root,pos x)
persistent = 0

[State stop moving right]
type = velset
trigger1 = facing = 1 && (pos x >= root,pos x)
trigger2 = facing = -1 && (pos x <= root,pos x)
x = 0
persistent = 0

[State remove flames]
type = removeexplod
triggerall = numexplod(stateno)
trigger1 = pos x = root,pos x
id = stateno

[State end]
type = changestate
trigger1 = pos x = root,pos x ;time = 222
value = 19799

