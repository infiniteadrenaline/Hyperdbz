; Taunt
[Statedef 195]
type = S
movetype = I
physics = S
ctrl = 0
anim = 195
velset = 0,0
sprpriority = 2

[State 0, changeanim]
type = changeanim
trigger1 = time = 0
trigger1 = facing = -1
value = 196

[State 0, changeanim]
type = changeanim
trigger1 = time = 0
trigger1 = life > p2life
value = 197

[State 0, snd];voice
type = playsnd
triggerall = anim = 196 || anim = 195
triggerall = numexplod(6900) = 0
trigger1 = time = 0
value = 195,random%7

[State -2, Explod]
type = Explod
triggerall = anim = 196 || anim = 195
triggerall = numexplod(6900) = 0
trigger1 = time = 0
anim = 5939
removetime = 240
id = 6900
ignorehitpause = 1
persistent = 0

[State swing snd]
type = playsnd
trigger1 = anim = 197 && (animelem = 2 || animelem = 6)
value = 0, 1
channel = 4

[State shuffle snd]
type = playsnd
trigger1 = anim = 197 && animelemno(0)%4 = 0 && animelemtime(animelemno(0)) = 0
value = 630,1
channel = 4


[State 0, snd];voice
type = playsnd
triggerall = anim = 197
triggerall = numexplod(6900) = 0
trigger1 = time = 0
value = 197,random%7

