;---------------------------------------------------------------------------
;Bound Helper
[Statedef 320000]
type = A
physics = N
movetype = I
ctrl = 0
juggle = 0

[State grab root data]
type = null
trigger1 = 1 || var(0)  := parent,id
trigger1 = 1 || var(1)  := parent,stateno
trigger1 = 1 || var(2)  := (parent,var(41)&1048575) ;Set Anim
trigger1 = 1 || var(3)  := floor(((parent,var(41))&15728640)/1048576) ;Set Sprpriority
trigger1 = 1 || var(4)  := floor(((parent,var(41))&50331648)/16777216) ;Grab Anim Mode
trigger1 = 1 || var(5)  := (parent,var(41)&67108864)!=0  ;Track Parent Flag
trigger1 = 1 || var(6)  := (parent,var(41)&134217728)!=0 ;Disable Shadow Flag
trigger1 = 1 || var(7)  := floor(((parent,var(41))&805306368)/268435456) ;Grab End Flags
trigger1 = 1 || var(8)  := parent,anim
trigger1 = 1 || var(9)  := (parent,var(41)&1073741824)!=0 ;Invisible Flag
;var(10) is essentially a kill switch. Any non-zero value will destroy the helper. Parent can use the Cond
;exploit to kill the helper whenever needed
;Var(12) is used when setting the animation. Set it to 0 so ya can set the helper to a new anim
trigger1 = 1 || var(13) := floor(parent,fvar(21)) ;Keep X Offset for binding
trigger1 = 1 || var(14) := floor(parent,fvar(22)) ;Keep Y Offset for binding
trigger1 = 1 || var(15) := (parent,var(41))<0 ;Explod Flag
;var(16) = ALPHA, src subtraction (Can be set via Cond Exploit)
;var(17) = ALPHA, dest subtraction (Can be set via Cond Exploit)
trigger1 = 1 || var(18) := floor(screenpos x) ;Initial Screenpos X for explods
trigger1 = 1 || var(19) := floor(screenpos y) ;Initial Screenpos X for explods
;var(50) is the "End" flag, ensures both regular and Explod helpers destroy the same ways
;fvar(0) is X Vel. Can be written to via the Cond Exploit
;fvar(1) is Y Vel. Can be written to via the Cond Exploit
persistent = 0

[State Disable Shadow]
type = assertspecial
trigger1 = var(6) && !var(9)
flag = noshadow
[State Invisible]
type = assertspecial
trigger1 = !var(6) && var(9)
trigger2 = var(15) ;Explod
flag = invisible
[State Disable Shadow + Invisible]
type = assertspecial
trigger1 = var(6) && var(9)
flag = noshadow
flag2 = invisible

[State transparency]
type = trans
trigger1 = var(16) || var(17)
trans = addalpha
alpha = 255-var(16),255-var(17)

[State Anim]
type = changeanim
triggerall = !var(9) ;Not Invisible
triggerall = !var(12)
trigger1 = var(4) != 1 ;Anim Mode != Match
trigger2 = var(15) ;Set if Explod
value = var(2)

[State Match Parent Anim]
type = changeanim
triggerall = !var(9) ;Not Invisible
triggerall = var(4) = 1 ;Anim Mode = Match
trigger1 = playeridexist(var(0))
value = var(2)
elem = playerid(var(0)),animelemno(0)

[State Anim is set]
type = varset
trigger1 = var(2) && anim != 0 && !var(12)
var(12) = 1

[State Sprpriority]
type = sprpriority
trigger1 = 1
value = var(3)
persistent = 0

[State XVelocity]
type = velset
trigger1 = 1
x = fvar(0)
y = fvar(1)

[State bind]
type = bindtoparent
triggerall = var(5) ;Bind to Parent Flag is set
trigger1 = playeridexist(var(0)) ;Parent still exists
pos = (var(13)*facing), var(14)

[State bind]
type = posadd
triggerall = !var(5) ;Bind to Parent Flag is set
trigger1 = playeridexist(var(0)) ;Parent still exists
x = (var(13)*facing)
y = var(14)
persistent = 0

[State bind]
type = null
triggerall = var(15) ;Explod
trigger1 = playeridexist(var(0)) ;Parent still exists
trigger1 = 1 || var(20) := var(20) + var(13)
trigger1 = 1 || var(21) := var(21) + var(14)
persistent = 0


[State spawn Explod]
type = explod
triggerall = var(15)
triggerall = !var(16) && !var(17)
trigger1 = !numexplod(anim+stateno)
postype = left ;Weird I know but if it works it works
pos = var(20),var(21)
id = anim+stateno
anim = anim
facing = facing
shadow = 255*!var(6),255*!var(6),255*!var(6)
bindtime = cond(var(5),-1,0)
removetime = cond(var(4) = 0, -2, -1)
trans = none
sprpriority = var(3)
persistent = 0

[State spawn Explod]
type = explod
triggerall = var(15)
triggerall = var(16) || var(17)
trigger1 = !numexplod(anim+stateno)
postype = left ;Weird I know but if it works it works
pos = var(20),var(21)
id = anim+stateno
anim = anim
facing = facing
shadow = 255*!var(6),255*!var(6),255*!var(6)
bindtime = cond(var(5),-1,0)
removetime = cond(var(4) = 0, -2, -1)
trans = addalpha
alpha = 255-var(16), 255-var(17)
sprpriority = var(3)
persistent = 0

[State explod tracks parent]
type = modifyexplod
triggerall = numexplod(anim+stateno)
trigger1 = var(15)
trigger1 = !var(16) && !var(17)
postype = left ;Weird I know but if it works it works
pos = var(20),var(21)
id = anim+stateno
trans = none
bindtime = -1

[State explod tracks parent]
type = modifyexplod
triggerall = numexplod(anim+stateno)
trigger1 = var(15)
trigger1 = var(16) || var(17)
postype = left ;Weird I know but if it works it works
pos = var(20),var(21)
id = anim+stateno
trans = addalpha
alpha = 255-var(16),255-var(17)
bindtime = -1


[State set End flag]
type = varset
trigger1 = !playeridexist(var(0)) ;Parent doesn't exist
trigger2 = !var(4) && !animtime && time > 0
trigger3 = (var(7)&1) !=0 ;End if parent Anim changed
trigger3 = cond((playeridexist(var(0))), (playerid(var(0)),anim != var(8)),0)
trigger4 = (var(7)&2) !=0 ;End if parent Stateno changed
trigger4 = cond((playeridexist(var(0))), (playerid(var(0)),stateno != var(1)),0)
trigger5 = var(10) ;Kill Switch essentially, Cond Exploit to kill the helper whenever ya want
trigger6 = var(15) && !numexplod(anim+stateno)
var(50) = 1

[State despawn explod]
type = removeexplod
triggerall = var(15) && var(50)
trigger1 = numexplod(anim+stateno)
id = anim+stateno

[State end]
type = destroyself
trigger1 = var(50)

