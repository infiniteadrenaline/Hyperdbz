trigger1 = 1 || var(2) := 1 ;Pink Bot base Sprpriority
trigger1 = 1 || var(11) := 0  ;Green Bot Swoosh SND time
trigger1 = 1 || var(12) := 40 ;Pink Bot Swoosh SND time
