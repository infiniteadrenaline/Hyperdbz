trigger1 = 1 || var(14) := -70 ;Green Bot X offset
trigger1 = 1 || var(15) := 60 ;Pink Bot X offset
trigger1 = 1 || var(16) := 2 ;Green Bot Puasetime on hit
trigger1 = 1 || var(17) := 4 ;Pink Bot Puasetime on hit
trigger1 = 1 || var(18) := cond(var(0) = 1, 221, 220) ;Land SND Group
trigger1 = 1 || var(19) := cond(var(0) = 1, 1, 0) ;Land SND Index
;Var(20) is used to indicate when a "hit" occurs
;Var(21) is used to fake hitpause
trigger1 = 1 || var(22) := cond(var(0) = 1, 5,2) ;Hit SND Group
trigger1 = 1 || var(23) := cond(var(0) = 1, 8,3) ;Hit SND Index
trigger1 = 1 || var(24) := 9 ;Green Bot Attack Start Animelem
trigger1 = 1 || var(25) := 2 ;Pink Bot Attack Start Animelem
trigger1 = 1 || var(26) := 88;Green Bot Attack End Animelem
trigger1 = 1 || var(27) := 40 ;Pink Bot Attack End Animelem
7 ;Pink Bot Attack End Animelem
trigger1 = 1 || var(28) := 4 ;Green Bot Attack Frequency
trigger1 = 1 || var(29) := 3 ;Pink Bot Attack Frequency
trigger1 = 1 || fvar(1) := 0.5 ;Green Bot "Weight"
trigger1 = 1 || fvar(2) := 0.8 ;Pink Bot "Weight"
trigger1 = 1 || fvar(3) := -5 ;Green Bot Bounce Up Speed
trigger1 = 1 || fvar(4) := -6 ;Pink Bot Bounce Up Speed
;Fvar(5) is a container for yaceel
trigger1 = 1 || fvar(6) := 13 ;Green Bot Fall Speed
trigger1 = 1 || fvar(7) := 9 ;Pink Bot Fall Speed
trigger1 = 1 || fvar(8) := -0.5 ;Green Bot Fly off Yaccel
trigger1 = 1 || fvar(9) := -0.2 ;Pink Bot  Fly off Yaccel
trigger1 = 1 || fvar(11) := 0.095 ;Green Bot Fly off Xaccel
trigger1 = 1 || fvar(12) := -0.035 ;Pink Bot  Fly off Xaccel
trigger1 = 1 || fvar(13) := 3 ;Green Bot Fly off Xaccel speedup
trigger1 = 1 || fvar(14) := -2.5 ;Pink Bot Fly off Xaccel speedup
trigger1 = 1 || fvar(15) := -2 ;Green Bot "Floor"
trigger1 = 1 || fvar(16) := -12 ;Pink Bot "Floor"
persistent = 0

