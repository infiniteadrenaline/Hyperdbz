;---------------------------------------------------
;Cameo Intro
[Statedef 196]
type = S
ctrl = 0
anim = 1

[State spawn helper Mech]
type = helper
;0 - Bonanza Bro
;1 - Kirby
;2 - Wily
;3 - Toc-Man
trigger1 = 1 || var(15):= random%7 ;Store RNG
stateno = 19800 + var(15)
id  = stateno
pos = 0,0
postype = P1
helpertype = normal
persistent = 0
[State spawn Pilaf]
type = helper
trigger1 = 1
stateno = 19700; + var(15)
id  = stateno + 1
pos = 0,0
postype = P1
helpertype = normal
persistent = 0

[State Landing Sound]
type = PlaySnd
triggerall = numhelper(stateno+1)
trigger1 = helper(stateno+1),anim = 47
value = 40, 0
channel = 18
persistent = 0
[State explosion]
type = PlaySnd
triggerall = numhelper(stateno+1)
trigger1 = helper(stateno+1),stateno = 19798
value = 1500,0;2000,2
channel = 19
volumescale = 56
persistent = 0

;Var(25) here is used to communicate stuff between the Helpers and root
;Bits 0-2 are SND Flags

[State Bonanza Bro theme]
type = PlaySnd
trigger1 = var(15) = 0
value = 19800,0
channel = 20
persistent = 0

[State Kirby theme]
type = PlaySnd
trigger1 = var(15) = 1
value = 19801,0
channel = 20
persistent = 0
[State Kirby flap SND]
type = PlaySnd
triggerall = var(15) = 1
trigger1 = (var(25)&1) !=0
value = 19801,1
channel = 19



[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = var(15) = 4
trigger2 = var(15) = 6
flag = nomusic


[State Wily theme]
type = PlaySnd
trigger1 = NumProjID(19802)
value = 19802,0
channel = 19
loop = 1
volumescale = 55
persistent = 0

[State Eggman theme]
type = PlaySnd
trigger1 = var(15) = 4
value = 19803,0
channel = 19
volumescale = 255
persistent = 0

[State Metrpid theme]
type = PlaySnd
trigger1 = var(15) = 6
value = 19806,0
channel = 19
volumescale = 255
persistent = 0

[State Kirby theme]
type = PlaySnd
trigger1 = var(15) = 1
value = 19801,0
channel = 20
persistent = 0

[State reset "Signal" bits]
type = varadd
trigger1 = (var(25)&7) != 0
var(25) = -(var(25)&7)

[State assert intro]
type = assertspecial
trigger1 = 1
flag = intro

[State end]
type = changestate
;trigger1 = var(25) ;Set in the helper to avoid visual weirdness
trigger1 = !numhelper(stateno) && !numhelper(stateno+1)
value = 0




