[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = Anim != [48,49]
;trigger2 = NumExplod(47)
;trigger3 = NumExplod(45)
physics = A         ;A,C,S,N
;ignorehitpause = 
;persistent = 
