[State 40, 4]
type = VelSet
triggerall =  (anim = [48,49])
trigger1 = AnimElemTime(1)>2
trigger1 = var(21) = 0
trigger1 = sysvar(1) = 1
trigger2 = var(21) = 2
trigger2 =  Var(16) >= 30 && command = "holdfwd"
;trigger2 = Vel Y = 0
x = cond(NumExplod(46), const(velocity.runjump.fwd.x),const(velocity.jump.fwd.x)); const(velocity.jump.back.x)))
persistent = 0
[State 40, 4]
type = VelSet
triggerall =  (anim = [48,49])
trigger1 = var(21) = 0
trigger1 = AnimElemTime(1)>2
trigger1 = sysvar(1) = -1
trigger2 = var(21) = 2
trigger2 =  Var(16) >= 30 && command = "holdback"
;trigger2 = Vel Y = 0
x =  const(velocity.jump.back.x)
;persistent = 0
;
[State 50, 3]
type = ChangeAnim
triggerall =  (anim = [48,49])
trigger1 = var(21) = 0
trigger1 = AnimElemTime(1)>2
trigger2 = var(21) != 0
trigger2 =  Var(16) >= 30 ;|| (PrevStateNo = [600,699])
trigger3 = var(21) = 2
;trigger3 = !NumExplod(47)
trigger3 = anim = 48 ;|| (PrevStateNo = [600,699])
trigger3 = AnimElemTime(1)>2
trigger3 = command = "holddown"
;trigger3 = command != "holda" && command != "holdb" && command != "holdc" && command != "holdy" && command != "holdz"  && command != "holdstart"
trigger3= Var(16) := 30
