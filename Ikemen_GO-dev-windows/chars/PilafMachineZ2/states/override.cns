triggerall =  Pos Y < -30
trigger1 = var(21) = 1
trigger1 = Var(16) < 30
trigger2 = var(21) = 2
trigger2 = Var(16) < 30
trigger2 = Pos Y <= -64
trigger3 = PrevStateNo = 3050
;trigger1 = Var(16) <30
;trigger2 = (PrevStateNo = [600,699])
;trigger3 = PrevStateNo = 140
persistent = 0
value = Cond(var(21)=0,49,48)  ;ifelse(var(4)=1,45,44)

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 48
trigger1 = !AnimTime
value = 48
elem = 2
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 48
trigger1 = Var(16) >= 28
value = 59
elem = 1
persistent = 0
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 59 && !animtime
value = 49
persistent = 0

[State 0, PlayerPush]
