;triggerall = !NumExplod(45)
trigger1 = !NumExplod(46)
;triggerall = !NumExplod(47)
trigger1 = anim = [48,49]
;trigger1 = Vel Y <= 0
x = 0
y = 0
persistent = 0

[State 0, Explod]
type = Explod
;triggerall = !NumExplod(47)
triggerall = !NumExplod(48)
trigger1 = anim = [48,49]
anim = 1
ID = 48
removetime = -1

[State 0, StateTypeSet]
type = StateTypeSet
;triggerall = !NumExplod(45)
;triggerall = !NumExplod(47)
trigger1 = anim = [48,49]
;trigger1 = NumExplod(48)
physics = N         ;A,C,S,N
;ignorehitpause = 
