fvar(5) = 0
ignorehitpause = 1

;
;;;===============================================================================
;;; ------- Damage Dampener --------
;;;===============================================================================
;
;;old damage dampener
;
;;Damage Dampener Variable (by POTS)
;[State -2, Damage based on hits]
;type		= VarSet
;triggerall	= Enemy, stateno != [120,159]
;triggerall	= var(1)!=2
;triggerall	= (StateNo != [2100,2215]) || (StateNo != [2400,2610]) ;no supermoves
;trigger1		= NumEnemy
;fvar(12)		= IfElse(enemynear,GetHitVar(hitcount)<2, 20, IfElse(enemynear,GetHitVar(hitcount)>=20, 2, 21-enemynear,GetHitVar(hitcount))) / 20.0  ;CFJ
;;fvar(12)= IfElse(enemynear,GetHitVar(hitcount)=0, 1, IfElse(enemynear,GetHitVar(hitcount)=1, .92, .85**enemynear,GetHitVar(hitcount)))  ;MVC
;ignorehitpause	= 1
;persistent	= 0
;
;[State -2, Damage based on hits] ;supermoves: Super Hurricane Kick, Soaring Dragon Strike, Kamehameha
;type		= VarSet
;triggerall	= Enemy, stateno != [120,159]
;triggerall	= var(1)!=2
;triggerall	= (StateNo = [2100,2215]) || (StateNo = [2400,2610]) ;supermove states
;trigger1		= NumEnemy
;fvar(12)		= Cond(var(39)<2, 20, Cond(var(39)>=20, 2, 21-var(39))) / 20.0  ;CFJ
;;fvar(12)= IfElse(enemynear,GetHitVar(hitcount)=0, 1, IfElse(enemynear,GetHitVar(hitcount)=1, .92, .85**enemynear,GetHitVar(hitcount)))  ;MVC
;ignorehitpause	= 1
;persistent	= 0
;;var(39) keeps count of the number of hits of the supermoves. It has been used for the sole purpose of reducing
;;the damage scaling during combos.
;;In each supermove state (that has a hitdef) or their helpers (which must hit) there's a VarAdd that
;;keeps count of the hits the supermoves do.
;
;
;[State -2, Reset var when the opponent recovers]
;type		= VarSet
;trigger1		= NumEnemy
;trigger1		= (enemynear,movetype!=H)
;trigger2		= !NumEnemy
;fvar(12)		= 1
;ignorehitpause	= 1
;persistent	= 1
;
;;Let's put everything in a single variable
;[State -2, Damage Multiplier]
;type		= VarSet
;trigger1		= 1
;fvar(15)		= fvar(12)* 1
;ignorehitpause	= 1
;
;;Damage Dampener
;[State -2, Dampener itself]
;type		= AttackMulSet
;trigger1		= 1
;value		= fvar(15)
;ignorehitpause	= 1
;
;
;[State -2, var (39) Reset]  ;in case the VarSets in the states don't work
;Type		= VarSet
;Trigger1		= Roundstate < 2
;Trigger2		= P2Stateno = [120,160]
;Trigger3		= enemynear, ctrl
;Trigger4		= P2StateType != A
;Trigger4		= P2MoveType != H
;var(39)		= 0
;ignorehitpause	= 1


;===============================================================================
; ------- Damage Dampener --------
;===============================================================================
 
; new damage dampener

[State -2, Counter Flag] 
type = VarSet
trigger1 = NumEnemy
fvar(8) = (EnemyNear, MoveType = A)
ignoreHitPause = 1
 
;Damage Dampener Variable (by POTS)
[State -2, Hit Count] 
type = VarAdd 
triggerall = stateno != 3050 && stateno != 3060 		;reduce scaling on TFK LVL1 and 2
triggerall = stateno != 3400				;EE kick
trigger1 = !IsHelper
trigger1 = MoveHit = 1 
trigger1 = !HitPauseTime 
trigger1 = !(HitDefAttr = SCA, AT) 
fvar(13) = 1 
 
[State -2, Hit Count Reset] 
type = VarSet 
trigger1 = NumEnemy && fvar(13) 
trigger1 = (EnemyNear, MoveType != H) && (EnemyNear, StateNo != 5300) 
fvar(13) = 0 
ignoreHitPause = 1
 
[State -2, Dampener] 
type = VarSet 
trigger1 = 1 
fvar(10) = ifElse(fvar(13) < 3, 24, ifElse(fvar(13) >= 23, 1, 24 - fvar(13))) / 24.0 
ignoreHitPause = 1 
 
[State -2, Dampener Limit] 
type = VarSet 
trigger1 = fvar(10) < 0 
fvar(10) = 0 
ignoreHitPause = 1 
 
[State -2, Root Dampener] 
type = VarSet 
trigger1 = 1 
fvar(11) = fvar(10) * ifElse(fvar(8), 1.2, 1) 
ignoreHitPause = 1









