trigger1= NumEnemy
trigger1= (enemynear,movetype!=H)
trigger2= !NumEnemy
var(7) = 0
ignorehitpause = 1
[State -2, only one (a.HP) bounce]
type=VarSet
trigger1= NumEnemy
trigger1= (enemynear,movetype!=H)
trigger2= !NumEnemy
var(41) = 0
ignorehitpause = 1
[State -2, only one (down.fwd HK special) bounce]
