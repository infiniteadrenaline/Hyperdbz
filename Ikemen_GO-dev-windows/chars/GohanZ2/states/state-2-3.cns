trigger1 = !numHelper(2011) && !numHelper(2021) && !numHelper(2311)
trigger1 = StateNo!=[2000,2030]
trigger1 = StateNo!=[2300,2320]
var(19) = 0

[State -2, Super Jump reset var when Gohan lands]
type=VarSet
trigger1= statetype!=A
var(22) = 0

[State -2, Reset Masenko limiter when the opponent recovers]
type=VarSet
trigger1= NumEnemy
trigger1= (enemynear,movetype!=H)
trigger2= !NumEnemy
var(28) = 0

;[State -2, Fatality in Destiny mode buffer reset]
;type=VarSet
;trigger1 = StateNo!=2900
;trigger1 = StateNo!=[2701,2773]
;var(33) = 0



[State -2, KO snd]
type = VarSet
trigger1 = alive && var(8) > 0
trigger2 = !alive && var(8) < 2
var(8) = IfElse(alive, 0, var(8) + 1)
ignorehitpause = 1

[state -2, emo gauge cap]
type = null;varset
trigger1 = fvar(28) > 300
fvar(28) = 300
ignorehitpause = 1

