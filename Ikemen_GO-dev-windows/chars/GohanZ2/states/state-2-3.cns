triggerall = target(755),Alive
trigger1 = !(target, ishelper)
trigger1 = target(755),command = "recovery"
value = 799

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = P2MoveType != H
id = 620

[State -2, EXPLODsive Buffering Helper]
type = Helper
trigger1 = !NumHelper(90000005)
stateNo = 90000005
ID = 90000005
