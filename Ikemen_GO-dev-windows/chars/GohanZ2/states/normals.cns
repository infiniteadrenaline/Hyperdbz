;---------------------------------------------------------------------------
; Taunt
[Statedef 195]
type = S
movetype = I
physics = S
ctrl = 0
anim = 195
velset = vel x*0.8,0
;velset = 0,0
sprpriority = 2

[State 0, KHH for Goten]
Type=Helper
TriggerAll = Fvar(28) = [200,299] 
TriggerAll = EnemyNear,StateNo != 3407
Trigger1=Anim=2401 && AnimElem = 3
StateNo = 92600
Id = StateNo
Name = "LVL 1 Blast for Goten"
PosType=P1
Pos = 77,-36;70,-42

[State 0, Training Emo Raise]
Type=VarAdd
Trigger1=Var(52)=1
Trigger1=!Time&&Fvar(28)<300
Trigger1=Command != "holddown"
FV=28
Value=ifelse((fvar(28)+100) < 300,100,300-fvar(28))
[State 0, Training Emo Lower]
Type=VarAdd
Trigger1=Var(52)=1
Trigger1=!Time&&Fvar(28)>0
Trigger1=Command="holddown"
FV=28
Value=IFElse(Fvar(28) - 100 > 0, -100, -Fvar(28))

[state 200, velmul]
type = velmul
trigger1 = !time
x = 0.8

[State 200, snd]
type = PlaySnd
trigger1 = animelemtime(3)=0
value = 195,0 

[State 195, 1]
type = CtrlSet
trigger1 = animelemtime(4)=0
value = 1

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


