;Enemy Grabbed
[Statedef 899]
type    = S
movetype= H
physics = N
velset = 0,0
 
[State 0, ChangeAnim2]
type = ChangeAnim2
trigger1 = !Time
value = 899
 
[State 0, PosSet]
type = PosSet
trigger1 = 1
y = 0
 
[State 0, SelfState]
type = SelfState
trigger1 = !AILEVEL
trigger1 = ((NumExplod(90000800) ||(NumExplod(800)))|| (command = "x" && command = "a")) && command != "up"
trigger2 = AILEVEL > 0 
trigger2 = Cond(AILevel = 8, 1,random < 470*(AIlevel ** 2 / 64.0))
value = Cond(enemynear,Var(0)=1,950,5940)

[State 0, SelfState]
type = SelfState
trigger1 = Time >= 9
value = 0
ctrl = 1
