;===========================================================================
;JUMP LAND NO FRICTION
;===========================================================================
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[state 52, velset]
type = velset
trigger1 = !time
trigger1 = !(prevstateno = 301 || prevstateno = 303)
x = 0
y = 0

[state 52, velset] ;AD DF/B velocity
type = velset
trigger1 = !time
trigger1 = prevstateno = 301 || prevstateno = 303
x = vel x
y = 0

[State 52] ;go to AD DF/B landing
type = changestate
trigger1 = prevstateno = 301 || prevstateno = 303
value = 305

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = PosSet
triggerall = PrevStateNo = 19201
trigger1 = Time = 0
x = fvar(29)

[State 0, StateTypeSet]
type = StateTypeSet
triggerall = !NumExplod(53)
trigger1 = RoundState = 2
trigger1 = command = "holddown"
statetype = C       

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = RoundState = 2
trigger1 = command != "holddown"
statetype = S      
[State 52, 3]
type = CtrlSet
triggerall = !NumExplod(53)
triggerall = RoundState =2
triggerall = prevstateno != 19302
triggerall = prevstateno != 19201
trigger1 = Time >= 1
value = 1

[State 52, ChangeState to Guarding]
type = ChangeState
triggerall = !NumExplod(53)
trigger1 = ctrl
trigger1 = (ifElse(P2dist x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (ifElse(P2dist x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))
trigger1 = InGuardDist && (PrevStateNo != [600,699])
value = 120

[State 52, ChangeState to Guarding]
type = ChangeState
triggerall = !NumExplod(53)
trigger1 = ctrl
trigger1 = (ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000001)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000003))
trigger1 = InGuardDist && (PrevStateNo != [600,699])
value = 120

[State 52, Assert: NoWalk]
type = AssertSpecial
trigger1 = Anim = 5
flag = NoWalk
ignoreHitPause = 1

[State 52, ChangeAnim to Turning]
type = ChangeAnim
trigger1 = ctrl && P2Dist x < -12
trigger1 = Anim != 5
value = 5

[State 52, Turn]
type = Turn
trigger1 = Anim = 5 && AnimElem = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0 || ctrl && command = "holddown"
value = Cond(ctrl && command = "holddown", 10,0)
ctrl = Cond(RoundState>=2,1,0)


;===========================================================================
; HITA_SHAKE - Changing anim
;===========================================================================

;HITA_SHAKE
[Statedef 5020]
type    = A
movetype= H
physics = N
velset = 0,0

[State 5020, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = 5010 + GetHitVar(animtype)

[State 5020, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype)

[State 5020, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5020, 5]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

;===========================================================================
; HIT_FALLRECOVER (still falling) Giving posadd
;===========================================================================
; HIT_FALLRECOVER (on the ground)
[Statedef 5201]
type    = A
movetype= H
physics = N
anim = 5200
velset = 0,0

[state 0, ishelper]
type = destroyself
trigger1 = ishelper

[State 5201, 1] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < -5

[State 5201, 3]
type = VelSet
