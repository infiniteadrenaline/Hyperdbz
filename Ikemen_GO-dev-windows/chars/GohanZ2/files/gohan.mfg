;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial
trigger1 = P2DisT x < -12 && StateType = A;JNP4.x
trigger2 = !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = (StateNo = [110,118]) || (StateNo = [300,303]); || StateNo = 111 || StateNo != 113 || StateNo != 114 || StateNo != 300 || StateNo != 301;5.1
flag = NoAirGuard
ignoreHitPause = 0

[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0

;===========================================================================
; HYPERS
;===========================================================================
; Destiny Mode
[State -1]
type = ChangeState
triggerall = enemy, name != "Saibamen Z2" && authorname = "Team Z2"
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = !AILevel
triggerall = RoundState = 2
triggerall = fvar(27)=0 ;No destiny mode
triggerall = NumExplod(90012602)
triggerall = NumExplod(90000210) && NumExplod(90000240) || NumExplod(90000215) && NumExplod(90000245)
triggerall = StateType != A  && !WinKo
triggerall = power >= 2000 && StateNo != 2800
trigger1 = Ctrl
trigger2 = StateNo=900
value = 2800

;Gekiretsu Ranbu
[State -1, Gekiretsu Ranbu]
type = ChangeState
triggerall= !AILevel
triggerall = (((ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && (NumExplod(90032506))) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && (NumExplod(90032404))))&& StateType != A) ||  (ifElse(Facing = 1, (NumExplod(90032506)),(NumExplod(90032404))) && StateType = A)
triggerall = NumExplod(90000230) || NumExplod(90000235) || NumExplod(90000240) || NumExplod(90000245) || NumExplod(90000250) || NumExplod(90000255)
triggerall = !WinKo ;&& StateType != A
triggerall = (ifelse(fvar(27)=0,power>=3000,power>=2000)) && StateNo != 2700; && fvar(27)=0 
trigger1 = Ctrl
trigger2 = StateNo = 100 || StateNo = 101
trigger3 = StateNo = 1300 && movecontact  ;Slash Chop
