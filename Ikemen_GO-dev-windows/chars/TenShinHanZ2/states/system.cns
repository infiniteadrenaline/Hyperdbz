[State 5120, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = AnimTime = 0
value2 = ,AT
time = 2

[State 5120, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = cond(((command = "z" && command = "c") || (NumExplod(90000220) && NumExplod(90000250)) || ((command = "holdz" && command = "holdc"))), 1300, 0)
ctrl = 1