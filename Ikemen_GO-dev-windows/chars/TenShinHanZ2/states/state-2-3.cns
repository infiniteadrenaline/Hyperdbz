id		= 30050
pos		= const(size.mid.pos.x),const(size.mid.pos.y)
helpertype	= normal
postype		= p1
keyctrl		= 0
StateNo		= 30050
supermovetime	= 0
pausemovetime	= 0
ownpal		= 1


