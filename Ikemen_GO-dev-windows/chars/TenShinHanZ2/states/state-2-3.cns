triggerall = winKO && !NumHelper(19875)
triggerall = var(13) = 2
triggerall = RoundState = 3
trigger1 = NumProjId(3000) 
trigger2 = NumHelper(2207)
trigger2 = helper(2207), MoveHit
trigger3 = NumHelper(2237)
trigger3 = helper(2237), MoveHit
ID = 19875
pos =  0,0
postype = left
StateNo = 19892
helpertype = normal
name = "superbackground"
pausemovetime = 999999
supermovetime = 999999
sprpriority = -5
