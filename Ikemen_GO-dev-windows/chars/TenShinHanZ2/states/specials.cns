[State 1013, VelSet]
type = VelSet
triggerall = PrevStateNo = 1011
triggerall = P2bodydist y < -60
trigger1 = Time = 0
x = P2DisT X/26 ;Const(velocity.jump.neu.x)
y = p2dist y/32

[State 1013, VelSet]
type = VelSet
triggerall = PrevStateNo = 1011
triggerall = P2bodydist y > -60
trigger1 = Time = 0
x = P2DisT X/26
y = Const(velocity.jump.y); - 2.5

[State 1013, VelSet]
