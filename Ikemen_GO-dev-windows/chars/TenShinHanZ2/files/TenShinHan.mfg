;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial
trigger1 = P2DisT x < -12 && StateType = A
trigger2 =  !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = StateNo = 110 || StateNo = 115 || StateNo = 111;5.1
flag = NoAirGuard
ignoreHitPause = 0

;The first state controller disables MUGEN's normal guard system if any of of these scenarios occur.
[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0

;Ungrounded
[State -1, Ungrounded]
type = ChangeState
value = IfElse(StateType != A, 3000, 3018)
triggerall = StateType != A
triggerall = ((ifElse(P2Dist x < -12, Facing = -1, Facing = 1) && NumExplod(90030114)) || (ifElse(P2Dist x < -12, Facing = 1, Facing = -1) && NumExplod(90030016))) 
;triggerall = IfElse(Facing = 1,(NumExplod(90030114)),NumExplod(90030016))
triggerall = NumExplod(90000230) || NumExplod(90000240) || NumExplod(90000250) || NumExplod(90000235) || NumExplod(90000245) || NumExplod(90000255)
triggerall = power >= IfElse(fvar(27)=0,3000,2000)
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
trigger1 = ctrl	;StateType != A && 
trigger2 = stateno = 100 || stateno = 101
trigger3 = (StateNo = [200,242]) && MoveContact && StateType = S
trigger4 = (StateNo = [250,299]) && MoveContact && StateType != A
trigger5 = StateNo = 245 && AnimElemTime(8)> 0 && MoveContact && StateType = S
trigger6 = StateNo = 246 && MoveContact && StateType = S 
trigger7 = (StateNo = [400,499]) && MoveContact && StateType != A
trigger8 = StateNo = 1504 && AnimelemTime(3)>=5 && AnimelemTime(4) <= 0
trigger9 = StateNo = 626 && AnimElemTime(3)>1
trigger10 = StateNo = 643 && MoveContact
trigger11  = StateType = A &&(StateNo = [600,619]) && MoveContact
trigger12 = StateType = A && StateNo = 630 && MoveContact
trigger13 = StateType = A && StateNo = 640 && AnimElemTime(4)>= 1 && AnimElemTime(6)<= 0 && MoveContact
trigger14 = StateType = A && StateNo = 641 && AnimElemTime(6)>= 1 && AnimElemTime(8)<= 0 && MoveContact
trigger15 = StateType = A && StateNo = 642 && AnimElemTime(3)>= 1 && AnimElemTime(5)<= 0 && MoveContact
trigger16 = StateNo = 105 && Time > 9
trigger17 = StateNo = 1501 && movecontact

;Air Ungrounded
[State -1, Ungrounded]
type = ChangeState
value = IfElse(StateType != A, 3000, 3018)
triggerall = Statetype = A
triggerall = IfElse(Facing = -1,(NumExplod(90030016)),NumExplod(90030114))
;triggerall = IfElse(Facing = 1,(NumExplod(90030114)),NumExplod(90030016))
triggerall = NumExplod(90000230) || NumExplod(90000240) || NumExplod(90000250) || NumExplod(90000235) || NumExplod(90000245) || NumExplod(90000255)
triggerall = power >= IfElse(fvar(27)=0,3000,2000)
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
trigger1 = ctrl	;StateType != A && 
trigger2 = stateno = 100 || stateno = 101
trigger3 = (StateNo = [200,242]) && MoveContact && StateType = S
trigger4 = (StateNo = [250,299]) && MoveContact && StateType != A
trigger5 = StateNo = 245 && AnimElemTime(8)> 0 && MoveContact && StateType = S
trigger6 = StateNo = 246 && MoveContact && StateType = S 
trigger7 = (StateNo = [400,499]) && MoveContact && StateType != A
trigger8 = StateNo = 1504 && AnimelemTime(3)>=5 && AnimelemTime(4) <= 0
trigger9 = StateNo = 626 && AnimElemTime(3)>1
trigger10 = StateNo = 643 && MoveContact
trigger11  = StateType = A &&(StateNo = [600,619]) && MoveContact
trigger12 = StateType = A && StateNo = 630 && MoveContact
trigger13 = StateType = A && StateNo = 640 && AnimElemTime(4)>= 1 && AnimElemTime(6)<= 0 && MoveContact
trigger14 = StateType = A && StateNo = 641 && AnimElemTime(6)>= 1 && AnimElemTime(8)<= 0 && MoveContact
trigger15 = StateType = A && StateNo = 642 && AnimElemTime(3)>= 1 && AnimElemTime(5)<= 0 && MoveContact
trigger16 = StateNo = 105 && Time > 9
trigger17 = StateNo = 1501 && movecontact




