; Focus Attack (aka Slashing Chop)
[State -1, Focus Attack]
type = ChangeState
triggerall = AILevel<=0
triggerall = roundstate = 2
triggerall = stateno !=[1300,1302]
triggerall = stateno != 106
triggerall = command = "holdz" && command = "holdc"
;triggerall = command = "z" && command = "c"
;triggerall = NumExplod(90000220) && NumExplod(90000250)
trigger1 = StateType = S
trigger1 = ctrl
value = 1300

; Dash Kick
[State -1, Dashing Kick]
type = changestate
triggerall = AILevel<=0
triggerall = roundstate = 2
;triggerall = statetype!=A
triggerall = stateno = 100 || stateno = 101 || stateno = 110 || stateno = 111
triggerall = cond(Facing = 1,NumExplod(90000006),NumExplod(90000004)) ;holdfwd
;trigger1 = command="c" && command!="holddown"
trigger1 = NumExplod(90000250) ||  command = "c"
trigger1 = (!NumExplod(90000021) && !NumExplod(90000022) && !NumExplod(90000023))
value = 350

;Power Charge
[State -1]
type = ChangeState
triggerall = AILevel<=0
triggerall = roundstate = 2
;triggerall = StateType != A
triggerall = Power < 3000
triggerall = stateno != 900
;triggerall = command = "holdb" && command = "holdy"
triggerall = NumExplod(90000210) && NumExplod(90000240) || command = "holdb" && command = "holdy"
triggerall = pos Y=[-180,0]
trigger1 = Ctrl
value = 900

;Back Throw
[State -1, Back Throw]
type = changestate
triggerAll = !AILevel
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))) && NumExplod(90000800)
trigger1 = roundstate=2 && ctrl && statetype=S && stateno!=100
value = 800

;Forward Throw
[State -1, Forward Throw]
type = changestate
triggerAll = !AILevel
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000006)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000004))) && NumExplod(90000800) || NumExplod(90000800)
trigger1 = roundstate=2 && ctrl && statetype=S && stateno!=100
value = 810
;===========================================================================
; COMMAND & SYSTEM MOVES
;===========================================================================

; Slashing Chop (aka Focus Attack)
[State -1, Slashing Chop]
type = ChangeState
triggerall= !AILevel
triggerall = RoundState = 2
triggerall = StateNo !=[1300,1302]
triggerall = StateNo != 106
triggerall = ((command = "z" && command = "c") || (NumExplod(90000220) && NumExplod(90000250)) || ((command = "holdz" && command = "holdc") && (PrevStateNo = 8452 || PrevStateNo = 5120)))
triggerall = NumExplod(90000220) && NumExplod(90000250)
trigger1 = StateType = S
trigger1 = ctrl
value = 1300

;Zetto Counter
[State -1, Zetto counter]
type = changestate
trigger1 = AILevel<=0
;4.5 preview
trigger1 = stateno=[150, 155];JNP4.x
;trigger1 = command="f2k" || command="f2p"
trigger1 = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000006)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000004)))
trigger1 = (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2) || (cond(NumExplod(90000205), 1, 0) + cond(NumExplod(90000215), 1, 0) + cond(NumExplod(90000225), 1, 0) >= 2) || (cond(NumExplod(90000230), 1, 0) + cond(NumExplod(90000240), 1, 0) + cond(NumExplod(90000250), 1, 0) >= 2) || (cond(NumExplod(90000235), 1, 0) + cond(NumExplod(90000245), 1, 0) + cond(NumExplod(90000255), 1, 0) >= 2)
trigger1 = roundstate=2 && power>=1000 && statetype!=A
value = 750

;Air Zetto Counter
[State -1, Air Zetto counter]
type = changestate
trigger1 = AILevel<=0
;4.5 preview
trigger1 = stateno=[150, 155];JNP4.x
;trigger1 = command="f2k" || command="f2p"
trigger1 = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000006)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000004)))
