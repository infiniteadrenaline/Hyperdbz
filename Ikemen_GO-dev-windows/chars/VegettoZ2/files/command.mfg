triggerall = power >= 1000
triggerall = statetype = A  && !WinKo
triggerall = stateno != 3000
trigger1 = ctrl
trigger2 = ((stateno = 600) || (stateno = 610) || (stateno = 620)) && movecontact
trigger3 = ((stateno = 630) || (stateno = 640) || (stateno = 650)) && movecontact
value = 3000

