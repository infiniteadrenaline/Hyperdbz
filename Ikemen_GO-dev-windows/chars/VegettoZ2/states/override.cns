;==========================================
; CNS File for Vegetto Z2 by Balthazar & XGargoyle
; Override files : jump, dash, etc.
;==========================================

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
facep2 = 1

[State 0, RemoveExplod]  ;Piccolo's clones
type = RemoveExplod
trigger1 = !Time
id = 991901

[State 0, Explod] ;pos adjust flag
type = Explod
triggerall = !NumExplod(330033)
trigger1 = !time
trigger2 = (abs(pos y)-abs(var(3)))>=5
anim = 15999
ID = 330033
removetime = -1
removeongethit = 1

[State 0, VarSet]  ;capture Y pos
type = VarSet
trigger1 = !time
fvar(15) = ScreenPos Y
ignorehitpause = 1
;persistent =

[State -2, PosSet]; Prevent beginning on the floor
type = PosSet
;triggerall = roundstate=2
triggerall = Pos Y >= -10 ;0
triggerall = prevstateno!=[200,500]
triggerall = prevstateno!=20
trigger1 = PrevStateNo = [191,194]
trigger2 = PrevStateNo = 5900
trigger3 = PrevStateNo = [701,703]
trigger4 = NumProjID(5000) ;custom state detector
;trigger5 = PrevStateNo = 0 ;???  WTF
y = var(3)+ 0.5*sin(gametime/10) ;cond(!NumProjID(190),var(3)+5,(fvar(3)+ 0.5*sin(gametime/10)))
;persistent = 0

[State 0, reset PalFX] ;if skip intro
type = PalFX
trigger1 = PrevStateNo = [191,194]
trigger2 = PrevStateNo = [701,703]
time = 1
add = 0,0,0
mul = 256,256,256
sinadd = 0,0,0,1
invertall = 0
color = 256
ignorehitpause = 1
;persistent = 1

[State -2, PosSet]; Prevent beginning on the floor
type = PosSet
triggerall = roundstate=2
trigger1 = PrevStateNo = 5900 && roundno>1  ;ugly hack to fix round 2 stance
y = var(3)
persistent = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State -2, PosAdd] ;not in the right Y pos? LOWER
type = PosAdd
triggerall = NumExplod(330033)
triggerall = roundstate=2
;triggerall = time>0
triggerall = pos y>var(3)
trigger1 = 1
;trigger1 = prevstateno=[200,500]
;trigger2 = stateno=0
y = -1 ;var(3)/10.0
;persistent = 0

[State -2, PosAdd] ;not in the right Y pos? UPPER
type = PosAdd
triggerall = NumExplod(330033)
triggerall = roundstate=2
;triggerall = time>0
triggerall = pos y<var(3)
trigger1 = 1
;trigger1 = prevstateno=[200,500]
;trigger2 = stateno=0
y = 1 ;-var(3)/10.0
;persistent = 0

[State 0, RemoveExplod] ;correct pos
type = RemoveExplod
trigger1 = abs(pos y)-abs(var(3))=[-1,1]
id = 330033
ignorehitpause = 1
;persistent =


[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

;---------------------------------------------------------------------------
; Stand to Crouch
[StateDef 10]
type = C
physics = C
moveType = I
velSet = 0,0
sprPriority = 0


[State 10, Reversed Commands: change to jumping]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holddown"
value = 40

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10
value = 10

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;Crouching
[StateDef 11]
type = C
physics = C
moveType = I
anim = 11
velSet = 0,0
sprPriority = 0

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 6 && !AnimTime
value = 11

[State 0, PosAdd]
type = PosAdd
triggerall = command = "holddown"
trigger1 = pos Y<var(3)+20
y = 1
ignorehitpause = 1
;persistent =


[State 0, ChangeState]
type = ChangeState
triggerall = command = "holddown"
trigger1 = command = "holdback"
trigger2 = command = "holdfwd"
value = 15
ctrl = 1
ignorehitpause = 1
;persistent =

;Crouch to Stand
[StateDef 12]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 0

[State 12, Reversed Commands: change to "fake" crouch state]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holdup"
value = 13

[State 12, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 12
value = 12

[State 12, End]
type = ChangeState
trigger1 = command = "holddown" && command != "holdup"
value = 10

[State 12, End]
type = ChangeState
trigger1 = !AnimTime
value = 0

;"Fake" crouch state (for reversed commands)
[StateDef 13]
type = C
physics = C
moveType = I
velSet = 0,0
sprPriority = 0
ctrl = 1

[State 13, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10 && Anim != 11 && Anim != 141
value = 10

[State 13, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 10 && !AnimTime
trigger2 = Anim = 141 && !AnimTime
value = 11

[State 0, ChangeState]
type = ChangeState
triggerall = command = "holddown"
trigger1 = command = "holdback"
trigger2 = command = "holdfwd"
value = 15
ctrl = 1
ignorehitpause = 1
;persistent =

;Crouch Walk
[Statedef 15]
type    = C
physics = C
sprpriority = 0
Anim = 11

[State 0, VelSet]
type = VelMul
trigger1 = prevstateno=52
y = 0.7 ;0.9
;ignorehitpause =
;persistent =

[State -2, PosAdd] ;not in the right Y pos?
type = PosAdd
triggerall = pos y>var(3)
trigger1 = prevstateno=52
y = var(3)/10.0
persistent = 0

[State 0, VelSet]
type = VelSet
trigger1 = pos y<=var(3)
y = 0
;ignorehitpause =
;persistent =


[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdfwd"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdback"
x = const(velocity.walk.fwd.x)/1.5

[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdback"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdfwd"
x = const(velocity.walk.back.x)/1.5

[State 0, ChangeState]
type = ChangeState
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
value = 11
ctrl = 1
ignorehitpause = 1
;persistent =


[State 12, End]
type = ChangeState
trigger1 = command != "holddown"
value = 12

[State 20, 1]
type = VelSet
trigger1 = AILevel
x = const(velocity.walk.fwd.x)



;===========================================================================
; WALK - Sounds added
;===========================================================================

[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 0, VelSet]
type = VelMul
trigger1 = prevstateno=52
y = 0.7 ;0.9
;ignorehitpause =
;persistent =

[State -2, PosAdd] ;not in the right Y pos?
type = PosAdd
triggerall = pos y>var(3)
trigger1 = prevstateno=52
y = var(3)/10.0
persistent = 0

[State 0, VelSet]
type = VelSet
trigger1 = pos y<=var(3)
y = 0
;ignorehitpause =
;persistent =


[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdfwd"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdback"
x = const(velocity.walk.fwd.x)

[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdback"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdfwd"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 1]
type = VelSet
trigger1 = AILevel
x = const(velocity.walk.fwd.x)

;===========================================================================
;JUMP START OVERRIDE
;===========================================================================
;
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,AT
time = 1

[State 40, HitBy]
type = HitBy
trigger1 = 1
value = SCA,AA,AP
time = 1

[State 40, Reversed Commands: change to "fake" crouch state]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holdup"
value = 13

[State 0, VarRandom]
type = VarRandom
trigger1 = !AILEVEL>0
trigger1 = !Time
v = 37
range = 0,6

[State -1, Super Jump Forward]
type = ChangeState
value = 10232
triggerall = AILevel>0 
triggerall = Var(37)=1
trigger1 = P2BodyDist X > 100 && random >500
trigger2 = (enemynear,movetype!=A || backedgebodydist<=10)

[State -1, Super Jump Backward]
type = ChangeState
value = 10233
triggerall = AILevel>0 
triggerall =  Var(37)=2
trigger1 = (P2BodyDist X =[1,60]) && random >500
trigger2 = (enemynear,movetype=A)

[State -1, Super Jump Straight Up]
type = ChangeState
value = 10231
triggerall = AILevel>0  
trigger1 =  Var(37)=3

[State 0, Explod]
type = Explod
trigger1 = !Time
anim = 15999
ID = 110
removetime = 8
removeongethit = 1

[State 100, jump SND]
type = playsnd
trigger1 = time = 0
value = 40,1
channel = 11

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, Direction]
type = VarSet
trigger1 = !AILevel
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
sysvar(1) = cond(!Time, 0, cond(command = "holdfwd", 1, cond(command = "holdback", -1, sysvar(1))))

[State 40, Direction (Reversed Commands)]
type = VarSet
trigger1 = !AILevel
trigger1 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
sysvar(1) = cond(!Time, 0, cond(command = "holdback", 1, cond(command = "holdfwd", -1, sysvar(1))))

[State 40, 2]
type = VarSet
triggerall = AILEVEL
trigger1 = P2BodyDist X > 80 && random >500
trigger2 = (enemynear,movetype!=A || backedgebodydist<=10)
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = AILEVEL
trigger1 = (P2BodyDist X =[1,60]) && random >500
trigger2 = (enemynear,movetype=A)
sysvar(1) = -1

[State 40, 4]
type = VelSet
;trigger1 = !IsHelper
trigger1 = AnimTime = 0
x = cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
;trigger1 = !IsHelper
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;===========================================================================
;JUMP UP OVERRIDE (taking into account super jump commands)
;===========================================================================

; Jump Up
[Statedef 50]
type    = A
physics = A

[State 0, CtrlSet]  ;prevent infinite from j.MK/j.SK
type = CtrlSet
triggerall = NumEnemy
triggerall = enemy,movetype=H
trigger1 = prevstateno=640
trigger2 = prevstateno=650
value = 0
ignorehitpause = 1
;persistent =

;jump link infinite prevention on tall chars--see -2 for removeexplod
[State 0, Explod]
type = Explod
trigger1 = NumExplod(52)<4
trigger1 = P2StateType != A
trigger1 = Time = 0
anim = 15999
ID = 52
removetime = -1
removeongethit = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = prevstateno!=850
trigger1 = time = 0
value = cond((vel x)=0, 41, cond((vel x)>0, 42, 43))
[State 50, 2] ;from airthrow
type = ChangeAnim
trigger1 = prevstateno=850
trigger1 = time = 0
value = 41

[state veladd F]
type = veladd
triggerall = !AILEVEL
triggerall = (prevstateno = [10231,10233])
trigger1 = time > 8 && vel X< 4
trigger1 = (cond(Facing = 1, (NumExplod(90000009) || NumExplod(90000006) || NumExplod(90000003)),(NumExplod(90000007) || NumExplod(90000004) || NumExplod(90000001))))
x = 0.25

[state veladd]
type = veladd
triggerall = AILevel>0 && numenemy
triggerall = prevstateno = [10231,10233]
triggerall = time > 8 && vel X< 4
trigger1 = enemynear,Movetype!=A
x = cond(enemynear,Movetype=H,0.5,0.25)

[state veladd R]
type = veladd
triggerall = !AILEVEL
triggerall = (prevstateno = [10231,10233])
trigger1 = time > 15 && vel X> -4
trigger1 = (cond(Facing = 1, (NumExplod(90000007) || NumExplod(90000004) || NumExplod(90000001)),(NumExplod(90000009) || NumExplod(90000006) || NumExplod(90000003))))
x = -0.1

[state veladd]
type = veladd
triggerall = AILevel>0
triggerall = prevstateno = [10231,10233]
trigger1 = time > 15 && vel X> -4
trigger1 = enemynear,Movetype=A
x = -0.1


[State 50, 3]
type = ChangeAnim
triggerall = (prevstateno != [10231,10233]) && (anim != 44) && (anim != 42) && (anim != 45)
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = (prevstateno != [10231,10233]) && (anim = 42)
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = 45  ;cond(var(4)=1,45,44)


[State 50, 3]
type = ChangeAnim
triggerall = prevstateno = [10231,10233]
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
;value = 44
value = Anim + 3

;===========================================================================
;JUMP LAND BOUNCE
[Statedef 52]
type    = S ;A
physics = N
ctrl = 0
anim = 47

[State 0, bounce]
type = PlaySnd
trigger1 = !time
trigger1 = !NumProjID(651)
value = 50,0
channel = -1
volumescale = 255
;ignorehitpause =
persistent = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 0, StateTypeSet]
type = StateTypeSet
triggerall = !NumExplod(56)
trigger1 = RoundState = 2
trigger1 = command = "holddown"
statetype = C       

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = RoundState = 2
trigger1 = command != "holddown"
statetype = S  

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = NumExplod(56)
trigger2 = !CTRL
flag = nostandguard
flag2 = nocrouchguard  

[State 0, Bounce]
type = VelSet
trigger1 = Time=1
y = var(3)/8.0 ;10.0 ;-5.8
;ignorehitpause =
;persistent =
[State 0, VelMul]
type = VelMul
trigger1 = pos y>var(3)+5
trigger1 = Time>0
x = 0.9
y = 0.92
;ignorehitpause =
;persistent =

[State 0, VelSet]
type = VelMul
trigger1 = pos y<=var(3)+5
y = 0.5
;ignorehitpause =
;persistent =




[State 52, ChangeState to jump]
type = ChangeState
trigger1 = ctrl
trigger1 = NumExplod(90000008) || NumExplod(90000009) || NumExplod(90000007)
value = 40

[State 52, 3]
type = CtrlSet
triggerall = !NumExplod(56)
triggerall = RoundState =2
triggerall = prevstateno != 19302  ;Saiyan Pod
triggerall = prevstateno != 7141 ;726 ;Goomba
triggerall = prevstateno != 19302
trigger1 = Time >= 8
value = 1

[State 52, ChangeState to Guarding]
type = ChangeState
triggerall = !NumExplod(56)
trigger1 = ctrl
trigger1 = (ifElse(P2dist x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (ifElse(P2dist x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))
trigger1 = InGuardDist && (PrevStateNo != [600,699])
value = 120

[State 52, ChangeState to Guarding]
type = ChangeState
triggerall = !NumExplod(56)
trigger1 = ctrl
trigger1 = (ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000001)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000003))
trigger1 = InGuardDist && (PrevStateNo != [600,699])
value = 120
[State 52, Assert: NoWalk]
type = AssertSpecial
trigger1 = Anim = 5
flag = NoWalk
ignoreHitPause = 1

[State 52, ChangeAnim to Turning]
type = null;ChangeAnim
trigger1 = ctrl && P2Dist x < -12
trigger1 = Anim != 5
value = 5

[State 52, Turn]
type = null;Turn
trigger1 = Anim = 5 && AnimElem = 1

[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdfwd"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdback"
x = const(velocity.walk.fwd.x)/2.0

[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdback"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdfwd"
x = const(velocity.walk.back.x)/2.0

[State 52, ChangeState to Walk]
type = ChangeState
trigger1 = ctrl
trigger1 = !NumExplod(90000008) && !NumExplod(90000009) && !NumExplod(90000007)
trigger1 = NumExplod(90000004) || NumExplod(90000006)
value = 20

[State 52, 4]
type = ChangeState
trigger1 = pos y<var(3);+20;AnimTime = 0
trigger2 = time>15;20
value = 0
ctrl = Cond(RoundState>=2,1,0)




