;AI routines
;====================================
;AI ROUTINES
;====================================

[State -1, AI Advanced Air Dash Forward]
type = ChangeState
value = 110
triggerall = (AILEVEL) && (numenemy) && (roundstate = 2)  && var(10) = 0 && pos Y < -20 && (pos y < -30 || vel y > 0)
triggerall = stateno != 105 && statetype = A
triggerall = AIlevel >= 5
trigger1 = (stateno = 1050 && anim = 1020)
trigger1 = cond(random<500,ctrl && random < (75 * (AILEVEL) ** 2 / 64.0), cond(AIlevel < 7, random < (75 * (AILEVEL) ** 2 / 64.0), ctrl))
trigger2 = ctrl && enemynear, stateno = 1060
trigger2 = enemynear, BackEdgeBodyDist >= 18
trigger2 = cond(AIlevel < 8, random < (500 * (AILEVEL) ** 2 / 64.0), (enemynear, Pos Y >= -300))

[State -1, AI Air Dash]
type = ChangeState
value = Ifelse((enemynear, Movetype = A && enemynear, vel x > 0 && random < 150) || enemynear, stateno = 301 && enemynear,movetype = H, 115, 110)
triggerall = (AILEVEL) && (numenemy) && (roundstate = 2)  && var(10) = 0 && pos Y < -20 && (pos y < -30 || vel y > 0)
triggerall = stateno != 105 && statetype = A
trigger1 = ctrl && time>5 && random < 75 * (AIlevel ** 2 / 64.0)
trigger1 = (p2bodydist x >= 80) && (p2bodydist y = [-40,155])
trigger2 = ctrl && enemynear, stateno = 301 && enemynear,movetype = H && random < 250 * (AIlevel ** 2 / 64.0)


[State -1, AI Fall Recovery]
type=changestate
value= ifelse((pos y>=-20), 5200, 5210)
trigger1= AILevel>0 && numenemy && statetype=A
trigger1= roundstate=2 && alive
trigger1= stateno=5050 && canrecover
trigger1= vel y>=-1 && random < 150*(AIlevel ** 2 / 64.0)

; AI Taunt
[State -1, AI Taunt]
type = ChangeState
triggerall = AILevel>0 && numenemy && roundstate=2 && StateType != A
triggerall = StateNo!=195
triggerall = cond(AILevel >= 7, fvar(20) != 1, AILevel < 7)
trigger1 = (p2bodydist x>=100) && P2movetype!=A
trigger1 = P2statetype != A
trigger1 = life > 600 && P2life < 300 ;salt to the injury
trigger1 = ctrl && (random < 150 + (150 * (enemy, name = "Freeza Z2" || enemy, name = "Blacku Z2"))) * (AIlevel ** 2 / 64.0)
trigger2 = (ctrl && var(51) = 1)  && (random < 64) && (enemynear, stateno = [5101,5102])
trigger3 = AILEVEL >= 4
trigger3 = ctrl && enemynear, stateno = 3279 && p2bodydist x >= 210
value = 195 


[State -1, AI Run]
type=changestate
value=100
triggerall= AILevel>0 && numenemy
triggerall= roundstate=2 && statetype=S
triggerall= ctrl && (stateno!=[100,106])
trigger1= (enemynear,movetype!=A) && p2bodydist x>=70 && random < 150*(AIlevel ** 2 / 64.0)
trigger2 = enemynear, statetype = A && enemynear, movetype != A && p2bodydist x = [0, 100]
trigger2 = random < 60 * (AIlevel ** 2 / 64.0)

[State -1, AI Jump]
type= changestate
value = 40
triggerall = AILevel>0 && numenemy
triggerall = roundstate=2 && statetype!=A 
trigger1 = ctrl && p2bodydist x > 60 && enemynear,hitdefattr = SC,AT
trigger1 = random < (20 + (10 * enemynear, movetype = A) ) * (AIlevel ** 2 / 64.0)
trigger2 = ctrl && prevstateno = 140 
trigger2 = random < (90 * (AIlevel ** 2 / 64.0))
trigger3 = cond(AILevel>6,(enemy, stateno != 1460),statetype!=A)
trigger3 = stateno = 1421 && movehit && var(42)!=3
trigger4 = stateno = 1421 && anim=304 && animelemtime(5) > 3 && movehit && var(42)=3

[State -1, AI Jump Launcher]
type= changestate
value = 10230
triggerall = AILevel>0 && numenemy
triggerall = roundstate=2 && statetype!=A 
triggerall= enemynear, stateno != 5050 
trigger1 = stateno = 1421 && anim=300 && animelemtime(15) >= 0 && movehit ;Normal High Ender
trigger1 = prevstateno != 1100

[State -1, AI Dash Backward]
type=changestate
