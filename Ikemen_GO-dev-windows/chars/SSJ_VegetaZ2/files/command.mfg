;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial
trigger1 = P2DisT x < -12 && StateType = A
trigger2 =  !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = StateNo = 110 || StateNo = 115 || StateNo = 111;5.1
flag = NoAirGuard
ignoreHitPause = 0

[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0


;===========================================================================
; BOSS SUPERS
;===========================================================================
;Air Final Explosion
[State -1, Air Final Explosion]
type = ChangeState
value = 48001
triggerAll = !AILevel
triggerall = power >= 3000
triggerall = ifelse(facing = 1, NumExplod(90032506),NumExplod(90032404))
triggerall = (ifElse(NumExplod(90000200), 1, 0) + ifElse(NumExplod(90000210), 1, 0) + ifElse(NumExplod(90000220), 1, 0) = 3) || (ifElse(NumExplod(90000205), 1, 0) + ifElse(NumExplod(90000215), 1, 0) + ifElse(NumExplod(90000225), 1, 0) = 3)
triggerall = StateType = A && !WinKO
triggerall =  fvar(36)
trigger1 = ctrl 
trigger2 = (stateno = [600,650]) || (stateno = 1050) || (stateno = 420)
trigger2 = movecontact
trigger3 = stateno = 310
trigger4 = anim = 1512 && animelemtime(6) >= 0
trigger5 = stateno = 1201 || stateno = 1203

;Final Explosion
[State -1, Final Explosion]
type = ChangeState
value = 48000
triggerAll = !AILevel
triggerall = power >= 3000
triggerall = ((ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90032506)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90032404))) 
triggerall = (ifElse(NumExplod(90000200), 1, 0) + ifElse(NumExplod(90000210), 1, 0) + ifElse(NumExplod(90000220), 1, 0) = 3) || (ifElse(NumExplod(90000205), 1, 0) + ifElse(NumExplod(90000215), 1, 0) + ifElse(NumExplod(90000225), 1, 0) = 3)
triggerall = StateType != A && !WinKO
triggerall =  fvar(36)
trigger1 = ctrl || stateno = 100
trigger2 = stateno = [200,450] 
trigger2 = prevstateno != 1100
trigger2 = stateno != 320
trigger2 = movecontact
trigger3 = stateno = 1100
trigger4 = stateno = [1000,1050]
trigger4 = movecontact
trigger5 = stateno = 1230 && anim = 48
trigger6 = stateno = [1400,1422]
trigger6 = movecontact
trigger7 = stateno = [1411,1412]
trigger8 = stateno = 2000 || stateno = 2400 || stateno = 2420 || stateno = 2425
trigger8 = movecontact

;Evolved Rave
[State -1, Evolved Rave]
type = ChangeState
value = 47000
triggerAll = !AILevel
triggerall = enemy, name != "SaibamenZ2"
triggerall =  power >= 3000
triggerall = cond((((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90032506)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90032404)))), ((ifElse(NumExplod(90000230), 1, 0) + ifElse(NumExplod(90000240), 1, 0) + ifElse(NumExplod(90000250), 1, 0) = 3) || (ifElse(NumExplod(90000235), 1, 0) + ifElse(NumExplod(90000245), 1, 0) + ifElse(NumExplod(90000255), 1, 0) = 3)), NumExplod(90012602) && (NumExplod(90000220) && NumExplod(90000250) || NumExplod(90000225) && NumExplod(90000255)))
triggerall = StateType != A && !WinKO
triggerall =  fvar(36)
trigger1 = ctrl || stateno = 100
trigger2 = stateno = [200,450] 
trigger2 = prevstateno != 1100
trigger2 = stateno != 320
trigger2 = movecontact
trigger3 = stateno = 1100
trigger4 = stateno = [1000,1050]
trigger4 = movecontact
trigger5 = stateno = 1230 && anim = 48
trigger6 = stateno = [1400,1422]
trigger7 = stateno = 2000 || stateno = 2400 || stateno = 2420 || stateno = 2425
trigger7 = movecontact
trigger8 = (stateno = [3400,3403]) || (stateno = [3410,3420])
trigger8 = movecontact && ifelse(anim = 3404, animelemtime(2) < 0,1)
trigger9 = stateno = 3404 && anim = 3406

;Dirty Bomb
[State -1, Dirty Bomb]
type = ChangeState
value = 45000
triggerAll = !AILevel
triggerall = power >= 2000
triggerall =  fvar(36)
;triggerall = cond(((ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90032506)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90032404))), (NumExplod(90000230) || NumExplod(90000235) || NumExplod(90000240) || NumExplod(90000245) || NumExplod(90000250) || NumExplod(90000255)), NumExplod(90012602) && (NumExplod(90000200) && NumExplod(90000230) || NumExplod(90000205) && NumExplod(90000235)))
triggerall = ((ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90032506)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90032404))) 
