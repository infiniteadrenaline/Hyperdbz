[Statedef -2]

;UNUSED Evolved Rave Finisher Trigger
[State 0, VarSet]
type = VarSet
trigger1 = 1
fvar(35) = 0

; --- LOCAL COOLDOWN TICKER BACKUP ---
[State -2, Local Countdown Routine]
type = VarAdd
triggerall = var(58) > 0         ; Tracks your synced variable clock
triggerall = numhelper(8005) = 0 ; Only ticks when the helper has fully left the screen Dist
trigger1 = roundstate = 2        ; Only ticks during active battle gameplay
var(58) = -1                     ; Subtracts 1 frame per tick

