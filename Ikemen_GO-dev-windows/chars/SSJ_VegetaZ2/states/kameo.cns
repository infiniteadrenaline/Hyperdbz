;---------------------------------------------------------------------------
; Kameo - automatic execution
;---------------------------------------------------------------------------

[StateDef 6565631]
type = S
physics = S
ctrl = 1

; DEBUG TEXT
[State 6565631, Hit]
type = DisplayToClipboard
trigger1 = 1
text = "KAMEO ATTACK!"
ignorehitpause = 1

; Then go to attack
[State 6565631, Go]
type = ChangeState
trigger1 = time = 5
value = 200
