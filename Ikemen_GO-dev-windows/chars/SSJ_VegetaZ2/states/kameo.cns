;---------------------------------------------------------------------------
; Kameo States - Partner character actions when on screen as kameo
;---------------------------------------------------------------------------

[StateDef 6565631]
type = S
physics = S
movetype = I
sprpriority = 2
ctrl = 1

[State 6565631, Idle]
type = ChangeState
trigger1 = time >= 180
value = 6565632

[StateDef 6565632]
type = S
physics = N
movetype = I

[State 6565632, Leave]
type = SelfState
trigger1 = time = 0
value = 6565620
