;---------------------------------------------------------------------------
; Kameo States - Partner character actions when on screen as kameo
;---------------------------------------------------------------------------

[StateDef 0]
type = S
physics = S
movetype = I

[State 0, Immediate Move]
type = ChangeState
trigger1 = AILevel > 0
trigger1 = time = 0
value = 200

[StateDef 200]
type = A
physics = S

[State 200, Light Punch Override]
type = HitDef
trigger1 = time = 0
attr = S, SA
damage = 10
hitflag = M
sprpriority = 3

[State 200, Play]
type = Attack
trigger1 = time = 0
value = 200
