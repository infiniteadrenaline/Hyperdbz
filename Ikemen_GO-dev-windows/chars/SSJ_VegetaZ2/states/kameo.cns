;---------------------------------------------------------------------------
; Kameo States - Partner character actions when on screen as kameo
;---------------------------------------------------------------------------

[StateDef 6565631]
type = S
physics = S
movetype = I
sprpriority = 2
ctrl = 1

; Detect input and route to moves
[State 6565631, Route Input]
type = ChangeState
trigger1 = time = 0
trigger1 = map(_iksys_kameoInput) = 1
value = 200

[State 6565631, Route Fwd]
type = ChangeState
trigger1 = time = 0
trigger1 = map(_iksys_kameoInput) = 2
value = 210

[State 6565631, Route Back]
type = ChangeState
trigger1 = time = 0
trigger1 = map(_iksys_kameoInput) = 3
value = 220

[State 6565631, Route Up]
type = ChangeState
trigger1 = time = 0
trigger1 = map(_iksys_kameoInput) = 4
value = 230

[State 6565631, Route Down]
type = ChangeState
trigger1 = time = 0
trigger1 = map(_iksys_kameoInput) = 5
value = 240

; Default: idle if nothing pressed
[State 6565631, Idle]
type = ChangeState
trigger1 = time >= 180
value = 6565632

[StateDef 6565632]
type = S
physics = N
movetype = I

[State 6565632, Leave]
type = SelfState
trigger1 = time = 0
value = 6565620
