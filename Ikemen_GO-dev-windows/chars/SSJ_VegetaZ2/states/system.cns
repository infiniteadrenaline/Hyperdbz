
;===========================================================================
; KAMEO ASSIST POLLING - DISABLED: now handled globally by kameo.zss
; This old per-character approach conflicted with the global tag state machine.
; The new system uses tagIn{redirectid} from StateDef -2 in kameo.zss.
;===========================================================================

; ===== KAMEO ATTACK ROUTING ==============================================
; W triggers call these generic states, we route to Vegeta's actual specials
; ==========================================================================
[StateDef 9210]  ; W (neutral) => Royal Rekka
type = S
movetype = I
physics = N
if time = 0 { selfState{value: 1400} }  ; Royal Buster chain start

[StateDef 9211]  ; W+forward => Superdash
type = S
movetype = I
physics = N
if time = 0 { selfState{value: 1000} }

[StateDef 9212]  ; W+back => Atomic Burst
type = S
movetype = I
physics = N
if time = 0 { selfState{value: 3200} }

[StateDef 9213]  ; W+down => Straight Shooter
type = S
movetype = I
physics = N
if time = 0 { selfState{value: 1200} }

[StateDef 9214]  ; W+up => Anti-air
type = S
movetype = I
physics = N
if time = 0 { selfState{value: 230} }

