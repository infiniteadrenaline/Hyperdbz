guard.sparkno = s7000
sparkxy = -20,-65
hitsound = s5, 2              ; True impact sound
guardsound = S6,1
animtype = Up
ground.type = High
ground.slidetime = 12
ground.hittime = 12
ground.velocity = -1.5,-9     ; Rockets the enemy sky-high for clean juggles
guard.velocity = -7
fall.recover = 0
air.velocity = -1.5,-9
fall = 1
air.animtype = back
envshake.time = 15            ; Cam rumble data matching the source file
envshake.ampl = 4
envshake.freq = 60
id = 8005

; --- TRUE LANDING DETECTION LOOP ---
[State 9230, Landing Animation Shift]
type = ChangeAnim
triggerall = anim = 420
trigger1 = pos y >= 0 && vel y > 0
value = 47                    ; True landing crouch recovery frames index

[State 9230, Land Physics Reset]
type = StateTypeSet
trigger1 = pos y >= 0 && vel y > 0
physics = S
statetype = S

[State 9230, Snap To Stage Floor]
type = PosSet
trigger1 = pos y > 0
y = 0

[State 9230, Kill Y Speed on Floor Touch]
type = VelSet
trigger1 = pos y >= 0 && vel y > 0
y = 0

; --- EFFECTS CHANNELS ---
[State 9230, Shockwave Dust helper Spawn]
type = Helper
trigger1 = anim = 47 && animelemtime(1) = 1
name = "LandFX"
StateNo = 17100
id = 17100
postype = P1
ownpal = 1

[State 9230, Landing Thud Audio]
type = PlaySnd
trigger1 = anim = 47 && animelemtime(1) = 1
value = 40, 0                 ; Ground impact rumble sound

; --- SCREEN DISMISSAL ---
[State 9230, Run Off-Screen]
type = VelSet
trigger1 = anim = 47 && !animtime
x = -8                        ; Runs away the millisecond his landing frames finish

; --- CRITICAL FIX 1: SHUT DOWN GLOBAL SIGNAL PIPELINE ---
[State 9230, Clear Global Variable Signal]
type = VarSet                 
trigger1 = frontedgebodydist < -50 || backedgebodydist < -50 || (anim = 47 && !animtime)
sysvar(4) = 0                 

; --- CRITICAL FIX 2: FORCE RE-ENTRY TO STANDBY PIPELINE ---
[State 9230, Return to Bench Sidelines]
type = SelfState
trigger1 = frontedgebodydist < -50 || backedgebodydist < -50 || (anim = 47 && !animtime)
value = const(StateTagWaitingOutside) 


; ---------------------------------------------------------------------------
; [State 9240] SSJ VEGETA KAMEO - DOWN: STRAIGHT SHOOTER (Side-Switch Flying Kick)
; ---------------------------------------------------------------------------
[Statedef 9240]
type    = S
movetype= A
physics = S
ctrl    = 0

[State 9240, Load True Animation]
type = ChangeAnim
trigger1 = time = 0
value = 1200                  ; True Straight Shooter startup animation ID

; --- TRUE AUDIO TRIGGERS ---
[State 9240, Call Out Voice]
type = PlaySnd
trigger1 = time = 5
value = 1400, 13 + random%2   ; True "Coming through!" voice line from script
channel = 0

[State 9240, Whoosh Sound]
type = PlaySnd
trigger1 = time = 5
value = 1200, 0               ; Flying kick zoom audio
channel = 1

; --- TRUE MOVEMENT LIFTOFF TRAJECTORY ---
[State 9240, Airborne Physics Transition]
type = StateTypeSet
trigger1 = time >= 3
statetype = A                 ; Automatically lifts helper off the ground
physics = N

[State 9240, Vertical Lift Offset]
type = PosAdd
triggerall = anim = 1200
trigger1 = time = 4
y = -6                        ; Lifts him 6 pixels into the air grid space

; --- THE SPEED BURST AT FRAME 12 ---
[State 9240, Burst Kick Velocity]
type = VelSet
trigger1 = time = 12
x = 12                        ; Shoots forward at full speed velocity 12

[State 9240, Shift to Flying Kick Anim]
type = ChangeAnim
triggerall = anim = 1200
trigger1 = animtime = 0
value = 1201                  ; Loads the actual foot-extended active flying animation

; --- TRUE HITBOX STRUCTURE ---
[State 9240, Hitbox: Twist-In-Place Stun]
type = HitDef
triggerall = !movecontact
triggerall = anim = 1201
trigger1 = time < 26
attr = A, SA                  ; Airborne, Special Physical Attack
damage = 40, 5                ; Adjusted baseline scaling for an assist tool
animtype = Medium	
guardflag = MA
hitflag = MAF
pausetime = 4,4
guard.pausetime = 13,13
sparkno = s7020               ; True medium yellow impact spark frame
guard.sparkno = s7000
sparkxy = 0,-60
hitsound = s1200, 1           ; True unique spinning hit noise effect
guardsound = S6,1
ground.type = High
ground.slidetime = 15
ground.hittime  = 22
ground.velocity = -7          ; Pushes enemy back while Vegeta zooms past them
guard.velocity = -5
fall = 1                      ; Forces a knockdown status for clean tech setups
fall.recover = 0
air.velocity = -4,-4
p2stateno = 9241              ; Forcefully pushes the opponent into our custom spinning stun!
id = 8005

; ===========================================================================
; GUARD BRANCH REDIRECT (Handles what happens if the enemy blocks)
; ===========================================================================
[State 9240, Guarded Branch Redirect]
type = ChangeState
trigger1 = moveguarded = 1     ; If the opponent successfully blocks the hit...
value = 9242                  ; ...instantly route Vegeta to our blocked airborne recoil state!

; --- FLIGHT TO LANDING TRANSITION LOOP ---
[State 9240, Shift to Descent Anim]
type = ChangeAnim
triggerall = anim = 1201
trigger1 = time >= 20
value = 1210                  ; True aerial descent stance

[State 1200, Force Fall Vector]
type = VelSet
trigger1 = anim = 1210
y = 1                         ; Gravity vector forcing him back to floor coordinates

[State 1200, Landing Drag Braking]
type = VelMul
trigger1 = anim = 1210 || anim = 1021
x = .96                       ; Slowly brakes his forward velocity sliding friction

; --- THE SIDE-SWITCH CROSS-UP TURNING BRAIN ---
[State 9240, Touchdown Reset Anim]
type = ChangeAnim
triggerall = anim = 1210
trigger1 = pos Y >= 0 && vel Y > 0
value = 1021                  ; True crouch-landing recovery frame

[State 9240, Snap To Stage Floor]
type = PosSet
trigger1 = pos y > 0
y = 0

[State 9240, Kill Falling Speed]
type = VelSet
trigger1 = anim = 1021
y = 0

[State 9240, Reset Ground Physics Engine]
type = StateTypeSet
trigger1 = anim = 1021
statetype = S
physics = S

[State 9240, Dynamic Cross-Up Turn Trigger]
type = Turn
trigger1 = anim = 1021 && animelemtime(1) = 0
trigger1 = p2dist X < -12      ; If he flew clean past them, spin around to face their spine instantly!

; --- EFFECTS CHANNELS ---
[State 9240, Dust Asset Spawn]
type = Helper
trigger1 = anim = 1021 && animelemtime(1) = 1
name = "LandFX"
StateNo = 17100
id = 17100
postype = P1
ownpal = 1

[State 9240, Landing Impact Audio]
type = PlaySnd
trigger1 = anim = 1021 && animelemtime(1) = 1
value = 40, 0                 ; True ground thump rumble sound

; --- SCREEN DISMISSAL ---
[State 9240, Run Off-Screen]
type = VelSet
trigger1 = anim = 1021 && animtime = 0
x = -8                        ; Sprints backward away from battle layout

; --- CRITICAL FIX 1: SHUT DOWN GLOBAL SIGNAL PIPELINE ---
[State 9240, Clear Global Variable Signal]
type = VarSet                 
trigger1 = frontedgebodydist < -50 || backedgebodydist < -50 || (anim = 1021 && animtime = 0)
sysvar(4) = 0                 

; --- CRITICAL FIX 2: FORCE RE-ENTRY TO STANDBY PIPELINE ---
[State 9240, Return to Bench Sidelines]
type = SelfState
trigger1 = frontedgebodydist < -50 || backedgebodydist < -50 || (anim = 1021 && animtime = 0)
value = const(StateTagWaitingOutside)


; ===========================================================================
; SSJ VEGETA STRAIGHT SHOOTER: CUSTOM HIT & GUARD BRANCHES
; ===========================================================================

; ---------------------------------------------------------------------------
; [State 9241] CUSTOM OPPONENT SPIN-STUN (Derived from Statedef 1202)
; ---------------------------------------------------------------------------
; NOTE: This state is applied to the OPPONENT, not the Kameo helper.
[Statedef 9241]
type     = A
movetype = H                  ; Flagged as Hit/Victim type
physics  = N
anim     = 5030
ctrl     = 0
facep2   = 1

[State 9241, Force Spin Animation]
type = ChangeAnim
trigger1 = selfanimexist(5052) && !time
value = 5052                  ; Forces the opponent into their spinning twist-stun frame

[State 9241, Match Height Alignment]
type = PosSet
trigger1 = !time
y = enemy, pos Y              ; Snaps opponent perfectly level with Vegeta's kick angle

[State 9241, Corner Safety Push]
type = PosAdd
triggerall = anim = 5052 || anim = 5030
trigger1 = BackEdgeBodyDist <= 20
trigger2 = FrontEdgeBodyDist <= 20
x = 20                        ; Prevents getting stuck out of bounds in the corner canvas

[State 9241, Freeze Combo Velocity]
type = VelSet
trigger1 = !time
x = 0
y = 0                         ; Freezes the enemy perfectly still in mid-air!
persistent = 0

[State 9241, Release Gravity After Stun Stun Window]
type = VelAdd
trigger1 = time > 50          ; Holds them completely helpless for 50 frames before falling!
y = 0.65

[State 9241, Fall back to ground recovery]
type = SelfState
trigger1 = pos Y >= 0 && Vel Y > 0
value = 5100                  ; Sends opponent safely back to standard engine bounce-down code


; ---------------------------------------------------------------------------
; [State 9242] SSJ VEGETA KAMEO - DOWN: BLOCKED RECOVERY (Statedef 1203)
; ---------------------------------------------------------------------------
; This runs ONLY if the opponent successfully guards the flying kick.
[Statedef 9242]
type     = A                  ; Shifts helper to Airborne physics automatically
movetype = I                  ; Transitions to Idle (safe recovery phase)
physics  = A                  ; Uses active gravity physics loop
anim     = 1221               ; Plays his official blocked recoil animation frame
ctrl     = 0

; --- CRITICAL FIX 1: SHUT DOWN GLOBAL SIGNAL PIPELINE ---
[State 9242, Clear Global Variable Signal]
type = VarSet                 
trigger1 = pos Y >= 0 && vel y > 0
sysvar(4) = 0                 

; --- CRITICAL FIX 2: FORCE RE-ENTRY TO STANDBY PIPELINE ---
[State 9242, Return to Bench Sidelines]
type = SelfState
trigger1 = pos Y >= 0 && vel y > 0 
value = const(StateTagWaitingOutside) 

