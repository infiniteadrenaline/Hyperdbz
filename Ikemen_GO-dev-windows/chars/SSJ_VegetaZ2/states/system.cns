; SPAWN AT AGRESSOR HELPER on W press
[State 0, Direct Kameo Helper]
type = Helper
trigger1 = command = "w" && ctrl
id = 8888
stateno = 9999
name = "KameoAttacker"
postype = p1
pos = -60, 0
facing = 1
keyctrl = 0
ownpal = 1

; --- HELPER ATTACK STATE ---
[Statedef 9999]
type = S
movetype = A
physics = N

; Attack animation
[State 9999, Anim]
type = ChangeAnim
trigger1 = time = 0
value = 1402

; HIT DEFINITION
[State 9999, Hit]
type = HitDef
trigger1 = time = 0
attr = S, SA
damage = 25
hitflag = MAF
guardflag = M
pausetime = 10, 10
numhits = 1
fall = 1

; Die after attack
[State 9999, Die]
type = DestroySelf
trigger1 = time = 40

