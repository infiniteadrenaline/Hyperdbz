triggerall = Numenemy
triggerall = var(49) = 1
triggerall = enemy, name != "SaibamenZ2"
triggerall = enemy, name != "FarmerZ2"
triggerall = enemy, pos y = 0
triggerall = enemy, pos x = [-240,240]
trigger1 = Winko
value = 181

[state 180, Normal Winposes]
