TriggerAll=Anim=1700
trigger1 =Fvar(5)=1 && animelem=4 && command != "holdx"
trigger2 =Fvar(5)=2 && animelem=6 && command != "holdy"
trigger3 =Fvar(5)=3 && animelem=6 && command != "holdz"
helpertype = normal
name = "Mine"
