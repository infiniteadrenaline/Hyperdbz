[State 0, ChangeState] ;Air Dash Forward Cancel
type = ChangeState
triggerall= !var(54) ;disable under emo exit
triggerall = var(10) = 0 ;limiter
triggerall = !ishelper
trigger1 = NumExplod(90000231) || NumExplod(90000241) || NumExplod(90000251)
trigger1 = time>=12;20
trigger1 = (cond(Facing = 1, NumExplod(90001016),NumExplod(90001064))) || (((cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2)) && !NumExplod(90000021) && !NumExplod(90000022) && !NumExplod(90000023) && !NumExplod(90000027) && !NumExplod(90000028) && !NumExplod(90000029) && (cond(Facing = 1, !NumExplod(90000024),!NumExplod(90000026))))
value = 110


[State 0, ChangeState] ;Air Dash Backward Cancel
type = ChangeState
triggerall= !var(54) ;disable under emo exit
triggerall = var(10) = 0 ;limiter
triggerall = !ishelper
trigger1 = NumExplod(90000231) || NumExplod(90000241) || NumExplod(90000251)
trigger1 = time>=12;20
triggerall = cond(Facing = 1, NumExplod(90001064),NumExplod(90001016)) || (cond(Facing = 1, NumExplod(90000024),NumExplod(90000026)) && (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2))
value = 115

