triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90001064)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90001016))) || (((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000024)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000026))) && (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2))
triggerall = StateType = S
trigger1 = ctrl
trigger2 = StateNo=195 && animelemtime(3)>=0
value = 105

; Super Jump
