;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial
trigger1 = P2DisT x < -12 && StateType = A
;trigger2 = var(10) =1
;trigger3 = vel x >= 0.1
trigger2 =  !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = StateNo = 110 || StateNo = 115 || StateNo = 111;5.1
flag = NoAirGuard
ignoreHitPause = 0

;These three state controllers are only used in three siuations: when the character has landed from a jump
;after switching sides (to get around a MUGEN bug where a character's directions don't switch until a
;tick has passed, after they've landed from a jump and switched sides); if one of the control reversing
;explods is active, or if (on a keyboard) two opposite directions are held simultaneously. For the first
;two cases, guarding should still be possible, but in the third, guarding should be disabled. In all other
;situations, MUGEN's default guard behavior works well enough!
     
;The first state controller disables MUGEN's normal guard system if any of of these scenarios occur.
[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0

;===========================================================================
; SPECIALS
;===========================================================================

; EMO Exit Mode
[State -1]
type = ChangeState
triggerall = numenemy
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = AILevel<=0
triggerall = roundstate = 2
triggerall = NumHelper(4750) ;EMO
triggerall= !var(54) ;disable under emo exit
;triggerall = command = "emo"
triggerall = NumExplod(90012602)
triggerall = NumExplod(90000210) && NumExplod(90000240) || NumExplod(90000215) && NumExplod(90000245)
triggerall = statetype != A  && !WinKo
triggerall = stateno != 4900
trigger1 = Ctrl
value = 4900

; EMO Mode
[State -1, EMO Mode]
type = ChangeState
triggerall = numenemy
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = AILevel<=0
triggerall = roundstate = 2
triggerall = !NumHelper(4750) ;No EMO
;triggerall = command = "emo"
triggerall = NumExplod(90012602)
triggerall = NumExplod(90000210) && NumExplod(90000240) || NumExplod(90000215) && NumExplod(90000245)
triggerall = statetype != A  && !WinKo
triggerall = power >= 2000 && stateno != 4000
trigger1 = Ctrl
trigger2 = stateno=900
value = 4000

;AIR Overdrive Deadly Breaker Lv.3
[State -1, AIR Overdrive Deadly Breaker Lv.3]
type = ChangeState
triggerall = numenemy
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = AILevel<=0
triggerall = roundstate = 2
; Corresponds to command = "QCF_HCB"
triggerall = cond(Facing = 1, NumExplod(90032204),NumExplod(90032306))
triggerall = NumExplod(90000200) || NumExplod(90000210) || NumExplod(90000220) || NumExplod(90000205) || NumExplod(90000215) || NumExplod(90000225)
triggerall = statetype = A  && !WinKo
triggerall = Cond(!NumHelper(4750),power>=3000,(power>=0 && var(52)>700))
triggerall= !var(54) ;disable under emo exit
triggerall = stateno != 3500
trigger1 = ctrl
trigger2 = ((stateno = 600) || (stateno = 610) || (stateno = 620)) && movecontact
trigger3 = ((stateno = 630) || (stateno = 640) || (stateno = 650)) && movecontact
trigger4 = var(40)=1540 && !NumExplod(9991450) ;Blitz Deadend
value = 3500

;Overdrive Deadly Breaker Lv.3
[State -1, Overdrive Deadly Breaker Lv.3]
type = ChangeState
triggerall = numenemy
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = AILevel<=0
triggerall = roundstate = 2
; Corresponds to command = "QCF_HCB"
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90032204)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90032306)))
triggerall = NumExplod(90000200) || NumExplod(90000210) || NumExplod(90000220) || NumExplod(90000205) || NumExplod(90000215) || NumExplod(90000225)
triggerall = statetype != A  && !WinKo
triggerall = Cond(!NumHelper(4750),power>=3000,(power>=0 && var(52)>700))
triggerall= !var(54) ;disable under emo exit
triggerall = !WinKo
triggerall = stateno != 3500 || stateno != 1250
trigger1 = ctrl
trigger2 = ((stateno = 200) || (stateno = [210,215]) || (stateno = 220)) && movecontact
trigger3 = ((stateno = 230) || (stateno = 240) || (stateno = 250)) && movecontact
trigger4 = ((stateno = 400) || (stateno = 410) || (stateno = 420)) && movecontact
trigger5 = ((stateno = 430) || (stateno = 440) || (stateno = 450)) && movecontact
trigger6 = stateno = 100 || stateno = 101
trigger7 = var(40)=1540 && !NumExplod(9991450) ;Blitz Deadend
value = 3500

;Clockwork Overdrive Lv.2
[State -1, Clockwork Overdrive Lv.2]
type = ChangeState
triggerall = AILevel<=0
triggerall = roundstate = 2
; Corresponds to command = "2QCF"
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && (NumExplod(90030016) || NumExplod(90030003))) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && (NumExplod(90030101) || NumExplod(90030114))))
triggerall = (cond(NumExplod(90000230), 1, 0) + cond(NumExplod(90000240), 1, 0) + cond(NumExplod(90000250), 1, 0) >= 2) || (cond(NumExplod(90000235), 1, 0) + cond(NumExplod(90000245), 1, 0) + cond(NumExplod(90000255), 1, 0) >= 2)
triggerall = Cond(!NumHelper(4750),power>=2000,power>=0)
triggerall = !WinKo
triggerall = stateno != 3600 || stateno != 1250
trigger1 = ctrl
trigger1 = statetype != A
trigger2 = ((stateno = 200) || (stateno = [210,215]) || (stateno = 220)) && movecontact
trigger2 = statetype != A
trigger3 = ((stateno = 230) || (stateno = 240) || (stateno = 250)) && movecontact
trigger3 = statetype != A
trigger4 = ((stateno = 400) || (stateno = 410) || (stateno = 420)) && movecontact
trigger4 = statetype != A
trigger5 = ((stateno = 430) || (stateno = 440) || (stateno = 450)) && movecontact
trigger5 = statetype != A
trigger6 = stateno = 100 || stateno = 101
trigger6 = statetype != A
trigger7 = var(40)=1540 && !NumExplod(9991450) ;Blitz Deadend
trigger7 = statetype = S;A
trigger7 = stateno=[1500,1522]
value = 3600

