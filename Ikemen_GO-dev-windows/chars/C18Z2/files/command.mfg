[State -1, Jump Launcher]
type = ChangeState
triggerall = Roundstate = [2,3]
triggerall= !AILevel
triggerall = NumExplod(90000008) || NumExplod(90000009) || NumExplod(90000007)
trigger1 = (StateNo = 1453) && animelemtime(5)>0
trigger2 = (StateNo = 243) && animelemtime(25)>0
value = 10230
 
