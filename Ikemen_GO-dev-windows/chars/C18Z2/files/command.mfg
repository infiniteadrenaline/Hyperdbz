triggerall = Roundstate = [2,3]
triggerall= !var(54) ;disable under emo exit
triggerall= !AILevel
;4.5 preview
;triggerall = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90001016)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90001064))
triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90001016)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90001064))) || (((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000026)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000024))) && (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2))
triggerall = StateType = S && ctrl
trigger1 = (StateNo!=[100,106])
value = 100

; Run Back
