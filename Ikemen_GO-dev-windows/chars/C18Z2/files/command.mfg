;==============================================================================================
;==========================================<GUARDING>==========================================
;==============================================================================================

;==============================================================================================
;Here, we override the MUGEN's default guard system, and add our own triggers. This will ensure
;that the player can always block as long as they are holding a direction away from the opponent.
;This block of code also adds "chicken guarding", which is allowing the player to air guard by holding
;not only back, but down-back and up-back.

;It is also recommended that you also override the guard states (120, 130, 131, 132, 140, 150, 151, 152, 154, 155)
;with an updated version that uses the EXPLODsive buffering system. A copy of those fixed states
;can be found in this character, and also in the release thread (here:PUT LINK HERE).

;NOTE if you plan to use the NoGuard Assertspecial SCTRL somewhere else you will instead need to modify the below states.
;==============================================================================================


[State -1, Stand Blocking]
type = ChangeState
;triggerAll = Var(29)=0 ;????
triggerAll = !AILevel
triggerAll = InGuardDist
triggerAll = StateType = S
triggerAll = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))
trigger1 = ctrl ;triggerAll = ctrl
;trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))
trigger2 = StateNo = [100,101]
value = 120

[State -1, Crouch Blocking]
type = ChangeState
triggerAll = !AILevel
triggerAll = InGuardDist
triggerAll = StateType = C
triggerAll = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000001)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000003))
trigger1 = ctrl ;triggerAll = ctrl
;trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000001)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000003))
trigger2 = StateNo = [100,101]
value = 120

[State -1, Air Blocking]
type = ChangeState
triggerAll = !AILevel
triggerAll = InGuardDist
triggerAll = StateType = A
triggerAll = ctrl
triggerall = StateNo != 110 && StateNo != 115 && StateNo != 111;5.1
;4.5 preview
;triggerAll = Var(10)=0
;triggerAll = (vel x <= 0)
trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))
trigger2 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000001)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000003))
trigger3 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000007)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000009))
value = 120

[State -1, Air Blocking]
type = ChangeState
triggerAll = !AILevel
triggerAll = InGuardDist
triggerAll = StateType = A
triggerAll = StateNo = 5210 && Time = 14
trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000004)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000006))
trigger2 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000001)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000003))
trigger3 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90000007)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90000009))
value = 120

;====================================
;AI ROUTINES
;====================================

[State -1, AI Air Dash]
type = ChangeState
triggerall= !var(54) ;disable under emo exit
triggerall = AILevel>0 && roundstate = 2 && numenemy && var(10) = 0 && pos Y < -20
triggerall = stateno != 105 && statetype = A && (p2bodydist x>=80) && (p2bodydist y=[-40,155])
triggerall =random < 75*(AIlevel ** 2 / 64.0)
triggerall = pos y < -50 || vel y > 0
trigger1 = ctrl && time>5
value = cond(enemynear,Movetype=A&&enemynear, vel x>0&&random<150,115,110)

[State -1, AI Fall Recovery]
type=changestate
trigger1= AILevel>0 && numenemy && statetype=A
trigger1= roundstate=2 && alive
trigger1= stateno=5050 && canrecover
trigger1= vel y>=-1 && random < 250*(AIlevel ** 2 / 64.0)
value= cond((pos y>=-20), 5200, 5210)

; AI Taunt
[State -1, AI Taunt]
type = ChangeState
triggerall = AILevel>0 && numenemy && roundstate=2 && StateType != A
triggerall =(p2bodydist x>=100) && P2movetype!=A
triggerall = P2statetype != A
triggerall = life>600 && P2life<300 ;salt to the injury
triggerall = StateNo!=195
trigger1 = ctrl && random < 150*(AIlevel ** 2 / 64.0)
value = 195

[State -1, AI Run]
type=changestate
trigger1= AILevel>0 && numenemy
trigger1= roundstate=2 && statetype=S
trigger1= !var(54) ;disable under emo exit
trigger1= ctrl && (stateno!=[100,106])
trigger1= (enemynear,movetype!=A) && p2bodydist x>=70 && random < 150*(AIlevel ** 2 / 64.0)
value=100

[State -1, AI Jump]
type= changestate
triggerall= AILevel>0 && numenemy
triggerall= roundstate=2 && statetype!=A && ctrl && StateNo != 100
