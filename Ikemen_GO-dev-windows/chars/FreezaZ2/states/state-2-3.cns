;===============================<(SNK) CHARGE BACK, FORWARD>================================

;==============================================================================================
;This is somewhat similar to the Capcom style of charge moves, but we won't be keeping track of
;the "back" charge, instead, we're gonna be keeping track of how long the player has held left or
;right: when a character facing either direction holds left, var(48) will increase by one every tick.
;And when a character (again, facing any direction) holds right, var(48) will *decrease* by one every
;tick. If at any point the character stops holding the direction they were holding, var(48) will be reset
;to 0.

;So, if var(48) is greater than or equal to 45, then that means the player has sufficiently charged left
;enough to perform a charge back, forward move (provided they are facing to the right). And if var(48) is
;less than or equal to -45, the player has sufficiently charged right long enough to perform a charge back,
;forward move (if they're facing to the left).

;As with the Capcom method of charge moves, var(49) is set to 10 (Capcom has a 16 tick charge buffer SNK
;uses a 10 tick one) once var(48) has incremented (or decremented) enough. This is our charge buffer, and
;as long as it's non-zero, we are able to perform a charge move. var(49) will slowly start counting down to
;0, however, if the player stops hold left or right!
;==============================================================================================
;==============================================================================================
[State -1, Left Charge Increment]
type = VarAdd
triggerAll = NumHelper(90000005) && !IsHelper
trigger1 = !AILevel
trigger1 = Helper(90000005), command = "holdback"
trigger2 = AILEVEL
var(48) = 1
ignoreHitPause = 1

;this will only activate if var(48) is greater than zero; this is to avoid this VarSet from activating
;when the player is charging right
[State -1, Left Charge Reset]
type = VarSet
triggerAll = var(48) > 0
triggerall = cond(NumHelper(90000005), !IsHelper || Helper(90000005), sysvar(4) !=  cond(ishelper,root,sysvar(4),sysvar(4)), 0)
trigger1 = !AILevel
trigger1 = Helper(90000005), command != "holdback" || Helper(90000005), command = "holdfwd"
var(48) = 0
ignoreHitPause = 1

[State -1, Right Charge Increment]
type = VarAdd
triggerall = cond(NumHelper(90000005), !IsHelper || Helper(90000005), sysvar(4) !=  cond(ishelper,root,sysvar(4),sysvar(4)), 0)
trigger1 = !AILevel
trigger1 = Helper(90000005), command = "holdfwd"
var(48) = -1
ignoreHitPause = 1

[State -1, Right Charge Reset]
type = VarSet
triggerAll = var(31) < 0
triggerall = cond(NumHelper(90000005), !IsHelper || Helper(90000005), sysvar(4) !=  cond(ishelper,root,sysvar(4),sysvar(4)), 0)
trigger1 = !AILevel
trigger1 = Helper(90000005), command != "holdfwd" || Helper(90000005), command = "holdback"
var(48) = 0
ignoreHitPause = 1

[State -1, Left/Right Charge Buffer Activation]
type = VarSet
;we need to remember to check the absolute value of var(48), since in the SNK method, it can be
;either positive or negative!
trigger1 = abs(var(48)) >= 45
;var(49) is only set to 10 (as opposed to 16 like the Capcom method) here because of the different
;way the charge buffer works in SNK games; see below for a more detailed discussion of this.
var(49) = cond(var(48) < 0, -16, 16)
ignoreHitPause = 1

[State -1, Left Charge Buffer Decrement]
type = VarAdd
trigger1 = abs(var(48)) < 45 && var(49) > 0
var(49) = -1

[State -1, Right Charge Buffer Decrement]
type = VarAdd
trigger1 = abs(var(48)) < 45 && var(49) < 0
var(49) = 1



;==============================================================================================
;Much like with Capcom-style charge moves, the length of time the command is active behaves very
;differently than with standard commands: instead of having the RemoveTime be a constant value,
;we use the current value of the charge buffer, var(49).
;==============================================================================================


