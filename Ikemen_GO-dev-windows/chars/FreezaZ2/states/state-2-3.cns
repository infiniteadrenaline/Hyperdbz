[State -2, sadism Gauge] ;don't go below 0
type = varset
triggerall = roundstate = 2
trigger1 = var(50)<(fvar(37)) ;0
var(50) = fvar(37);0
ignorehitpause = 1

; SADISM MODE GAUGE - Fill it !!!
[State -2, sadism Gauge] ;fill
type = varadd
triggerall = roundstate = 2
triggerall = numtarget
trigger1 = var(50)>0 && var(50)<900
var(50) = ifelse (var(50) + ceil(1.25*(target,gethitvar(damage))) > 900, 900-var(50), ceil(1.25*(target,gethitvar(damage))) )
ignorehitpause = 1

[State -2, sadism Gauge] ;buffer
type = varset
triggerall = roundstate = 2
triggerall = movetype=H && !time
trigger1 = var(50)>0 && var(50)<900
var(51) = ifelse (var(50) + ceil(1.25*(gethitvar(damage))) > 900, -1*(900-var(50)), -ceil(1.25*(gethitvar(damage))) )
ignorehitpause = 1

[State -2, sadism Gauge] ;deplete
type = varset
triggerall = roundstate = 2
triggerall = movetype=H && !time
trigger1 = var(50)>0 && var(50)<900
var(50) = ifelse ((var(50)+var(51)<=0),var(50)-var(50)+1,(var(50)+var(51)))
ignorehitpause = 1

[State -2, sadism Gauge] ;lose
type = varset
triggerall = roundstate != 2
trigger1 = Lose
var(50) = 0
ignorehitpause = 1

[State -2, sadism Gauge] ;max
type = varset
triggerall = roundstate = 2
trigger1 = var(50)>900
var(50) = 900
ignorehitpause = 1


