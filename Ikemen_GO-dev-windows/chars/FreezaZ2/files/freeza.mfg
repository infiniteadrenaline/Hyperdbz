triggerall = pos Y < -10
trigger1 = ctrl
trigger2 = (StateNo = 600) || (StateNo = 610) || (StateNo = 620) || (StateNo = 630) || (StateNo = 640) || (StateNo = 650) || (StateNo = 660)
trigger2 = movecontact
trigger3 = stateno = 1400 || stateno = 1450		;Air headbutt
