;Death Ball Lv3 AIR
[State -1, Death Ball Lv3 AIR]
type = ChangeState
triggerall= !AILevel
;triggerall = roundstate = 2
;triggerall = command = "2qcb3p"
;triggerall = ((cond(P2DisT x < -12, Facing = -1, Facing = 1) && (NumExplod(90030101) || NumExplod(90030114))) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && (NumExplod(90030016) || NumExplod(90030003))))
