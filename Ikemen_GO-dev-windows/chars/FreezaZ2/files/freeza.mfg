triggerall = (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 3) || (cond(NumExplod(90000205), 1, 0) + cond(NumExplod(90000215), 1, 0) + cond(NumExplod(90000225), 1, 0) >= 3)
triggerall = (power >= 3000); || (var(50)>0)
triggerall = numhelper(2205) = 0 && numhelper(2210) = 0
