;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial
trigger1 = P2DisT x < -12 && StateType = A
trigger2 =  !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = StateNo = 110 || StateNo = 115 || StateNo = 111;5.1
flag = NoAirGuard
ignoreHitPause = 0
 
;These three state controllers are only used in three siuations: when the character has landed from a jump
;after switching sides (to get around a MUGEN bug where a character's directions don't switch until a
;tick has passed, after they've landed from a jump and switched sides); if one of the control reversing
;explods is active, or if (on a keyboard) two opposite directions are held simultaneously. For the first
;two cases, guarding should still be possible, but in the third, guarding should be disabled. In all other
;situations, MUGEN's default guard behavior works well enough!

;The first state controller disables MUGEN's normal guard system if any of of these scenarios occur.
[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0
 

;===========================================================================
; HYPERS
;===========================================================================

; Death Charge (Flaming Headbutt)
[State -1, Death Charge]
type = ChangeState
;triggerall = fvar(37) = 0
triggerall = !AILevel
triggerall = roundstate = 2 && StateType != A
triggerall = (var(50)>0 && fvar(37) = 0) || (fvar(37)=1 && Power >= 3000);in sadism mode
;triggerall = command = "emo" || command = "cbfbfp"
;triggerall = NumExplod(90012602) || cond(Facing = 1,NumExplod(90030616),NumExplod(90030714))
;triggerall = NumExplod(90000200) || NumExplod(90000210) || NumExplod(90000220) || (NumExplod(90000210) && NumExplod(90000240)) || (NumExplod(90000215) && NumExplod(90000245))
triggerall = (NumExplod(90012602) && NumExplod(90000210) && NumExplod(90000240)) || (((cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90030616)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90030714))) && (NumExplod(90000200) || NumExplod(90000205) || NumExplod(90000210) || NumExplod(90000215) || NumExplod(90000220) || NumExplod(90000225)))
triggerall = !WinKo
triggerall = stateno != 2680 && stateno<2000
triggerall = StateNo != [1550,1566]
trigger1 = Ctrl 
trigger2 = ((stateno = 200) || (stateno = 210) || (stateno = 220)) && movecontact
trigger3 = ((stateno = 230) || (stateno = 240) || (stateno = 250) || (stateno = 255)) && movecontact
trigger4 = ((stateno = 400) || (stateno = 410) || (stateno = 420)) && movecontact
trigger5 = ((stateno = 430) || (stateno = 440)) && movecontact
trigger6 = stateno = 100 || stateno = 101 || stateno = 104 
trigger7 = numhelper(1110)
trigger7 = helper(1110),movecontact
trigger8 = numhelper(1111)
trigger8 = helper(1111),movecontact
trigger9 = numhelper(1112)
trigger9 = helper(1112),movecontact
trigger10 = numhelper(1210)
trigger10 = helper(1210),movecontact
trigger11 = numhelper(1211)
trigger11 = helper(1211),movecontact
trigger12 = numhelper(1212)
trigger12 = helper(1212),movecontact
trigger13 = (stateno=1400 || stateno=1450) && anim=48 && movecontact
trigger14 = numhelper(1151)
trigger14 = helper(1151),movecontact
trigger15 = numhelper(1251)
trigger15 = helper(1251),movecontact
trigger16 = stateno=1801 && movecontact   ;Torture Gun
trigger17 = StateNo = 900
value = 2680

; Sadism Mode
[State -1, sadism activation]
type = ChangeState
triggerall = fvar(37) = 0
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = !AILevel
triggerall = roundstate = 2
triggerall = var(50)=0 ;No sadism mode
triggerall = StateNo != [1550,1566]
triggerall = NumExplod(90012602)
triggerall = NumExplod(90000210) && NumExplod(90000240) || NumExplod(90000215) && NumExplod(90000245)
triggerall = statetype != A  && !WinKo
triggerall = power >= 2000 && stateno != 2600
trigger1 = Ctrl
trigger2 = stateno = 900
value = 2600

;Tail Press Nightmare Lv3
[State -1, Tail Press Nightmare Lv3]
type = ChangeState
triggerall= !AILevel
;triggerall = roundstate = 2
;;triggerall = command = "2qcf2k"
;triggerall = (((command = "2qcfa") || (command = "2qcfb") || (command = "2qcfc")) && NumExplod(20)=0) || (((command = "2qcba") || (command = "2qcbb") || (command = "2qcbc")) && NumExplod(20)=1)
