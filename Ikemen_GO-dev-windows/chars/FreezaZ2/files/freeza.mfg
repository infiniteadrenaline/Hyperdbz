trigger4 = helper(1210),movecontact
trigger5 = numhelper(1211) 
trigger5 = helper(1211),movecontact
trigger6 = numhelper(1212) 
trigger6 = helper(1212),movecontact
trigger7 = numhelper(1251) 
trigger7 = helper(1251),movecontact
trigger8 = stateno=1566 && anim=1510
trigger9 = ((stateno = 1600) || (stateno = 1601) || (stateno = 1602)) && movecontact
value = 2470

