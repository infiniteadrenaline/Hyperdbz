type = VarSet
trigger1 = !animtime
var(15)=0
ignorehitpause = 1
;persistent =

[State 0, VarAdd]
type = VarAdd
trigger1 = Anim = 1001
trigger1 = AnimElemTime(1) = 1
fvar(14) = 7

[State 0]
Type=ChangeAnim
Trigger1 = Anim != 1001
;Trigger1=AnimElemTime(3) >=  5 + NumHelper(1005) * 5 && AnimElemTime(3) < 30		                  ;^ frames to delay
