triggerall = statetype=A && !WinKo
triggerall = pos Y < -60
triggerall = !NumHelper(9997)   ;Limit timer
trigger1 = ctrl
trigger2 = (StateNo = 600) || (StateNo = 630) || (StateNo = 610) || (StateNo = 620) || (StateNo = 640) || (StateNo = 650) || (StateNo = 655) || (StateNo = 255)
