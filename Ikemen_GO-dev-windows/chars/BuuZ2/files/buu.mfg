triggerall = (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2) || (cond(NumExplod(90000205), 1, 0) + cond(NumExplod(90000215), 1, 0) + cond(NumExplod(90000225), 1, 0) >= 2)
triggerall = statetype != A  && !WinKo
triggerall = !NumHelper(2150) ;No Vice Shot
triggerall = !NumHelper(2450) ;No Vice Shot
trigger1 = Ctrl
trigger2 = stateno = 100 || stateno = 101
trigger3 = stateno = 1300 && movecontact  ;Slash Chop
trigger4 = ((stateno = 200) || (stateno = 205) || (stateno = 210) || (stateno = 211) || (stateno = 220)) && movecontact
trigger5 = ((stateno = 230) || (stateno = 240) || (stateno = 245) || (stateno = 250) || (stateno = 255)) && movecontact
