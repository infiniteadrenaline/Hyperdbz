;==============================================================================================
;========================================<-1 STATES>===========================================
;==============================================================================================
[StateDef -1]

[State -1, AssertSpecial: NoAirGuard]
type = AssertSpecial
trigger1 = P2DisT x < -12 && StateType = A
trigger2 =  !NumExplod(90000004) && !NumExplod(90000006) && !NumExplod(90000001) && !NumExplod(90000003) && !NumExplod(90000007) && !NumExplod(90000009)
trigger3 = StateNo = 110 || StateNo = 115 || StateNo = 111;5.1
flag = NoAirGuard
ignoreHitPause = 0

;These three state controllers are only used in three siuations: when the character has landed from a jump
;after switching sides (to get around a MUGEN bug where a character's directions don't switch until a
;tick has passed, after they've landed from a jump and switched sides); if one of the control reversing
;explods is active, or if (on a keyboard) two opposite directions are held simultaneously. For the first
;two cases, guarding should still be possible, but in the third, guarding should be disabled. In all other
;situations, MUGEN's default guard behavior works well enough!
     
;The first state controller disables MUGEN's normal guard system if any of of these scenarios occur.
[State -1, AssertSpecial: No StandGuard and NoCrouchGuard]
type = AssertSpecial
triggerAll = !AILevel
trigger1 = P2dist x < -12 && StateType != A
trigger2 = NumExplod(94646464) || NumExplod(92468246)
trigger3 = command = "holdback" && command = "holdfwd" || command = "holdup" && command = "holddown"
flag = NoStandGuard
flag2 = NoCrouchGuard
ignoreHitPause = 0

;===========================================================================
; HYPERS
;===========================================================================

[State -1, Armor emo exit]
type = ChangeState
triggerall = !AILevel
;triggerall = roundstate = 2
triggerall = !NumHelper(9996) ;MCB Limiter
triggerall = !NumHelper(1605) ;enemy is not candied
triggerall = var(32)>0 && !NumHelper(999916);EMO mode and not during EMO exit
;triggerall = command = "emo"
triggerall = NumExplod(90012602)
triggerall = NumExplod(90000210) && NumExplod(90000240) || NumExplod(90000215) && NumExplod(90000245)
triggerall = statetype != A  && !WinKo
;triggerall = power >= 2000 && stateno != 2900
trigger1 = Ctrl
value = 2900

;LVL3 Startup
[State -1, Kill You! EMO Startup]
type = ChangeState
triggerall = numenemy
triggerall = !AILevel
;triggerall = !NumHelper(999916) ;ARMOR Limiter
triggerall = roundstate = 2
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = ((var(32)=0 || fvar(38) = 1) && power >= 3000) || (var(32)>0 && fvar(38) = 0 && power >= 2000)
;triggerall = var(32)=0 ;No EMO mode
; Corresponds to command = "2QCB"
triggerall = cond(Facing = 1, (NumExplod(90030101) || NumExplod(90030114)),(NumExplod(90030016) || NumExplod(90030003)))
triggerall = NumExplod(90000230) || NumExplod(90000240) || NumExplod(90000250) || NumExplod(90000235) || NumExplod(90000245) || NumExplod(90000255)
triggerall = statetype != A  && !WinKo
;triggerall = power >= 3000
triggerall = stateno != 4000
trigger1 = Ctrl
trigger2 = stateno = 100 || stateno = 101
trigger3 = stateno = 1300 && movecontact  ;Slash Chop
trigger4 = ((stateno = 200) || (stateno = 205) || (stateno = 210) || (stateno = 211) || (stateno = 220)) && movecontact
trigger5 = ((stateno = 230) || (stateno = 240) || (stateno = 245) || (stateno = 250) || (stateno = 255)) && movecontact
trigger6 = ((stateno = 400) || (stateno = 410) || (stateno = 420)) && movecontact
trigger7 = ((stateno = 430) || (stateno = 440) || (stateno = 450)) && movecontact
value = 4000


;===========================================================================
; SUPERS LV.2
;===========================================================================


; EMO Mode
[State -1, EMO Mode]
type = ChangeState
triggerall = fvar(37) = 0
triggerall = numenemy
triggerall = TeamMode != Simul
triggerall = enemyNear,TeamMode != Simul
triggerall = (enemy,Name != "Saibamen Z2")
triggerall = !AILevel
;triggerall = roundstate = 2
triggerall = !NumHelper(9996) ;MCB Limiter
triggerall = var(32)=0 || Var(32) > 0 && NumHelper(999916);No EMO mode or during EMO exit
;triggerall = command = "emo"
triggerall = NumExplod(90012602)
triggerall = NumExplod(90000210) && NumExplod(90000240) || NumExplod(90000215) && NumExplod(90000245)
triggerall = statetype != A  && !WinKo
triggerall = power >= 2000 && stateno != 2700
trigger1 = Ctrl
trigger2 = stateno=900
value = 2700

;Air Vice Shot
[State -1, Air Vice Shot Lv.2]
type = ChangeState
triggerall = !AILevel
;triggerall = !NumHelper(9996) ;MCB Limiter
;triggerall = roundstate = 2
triggerall = stateno != 2403
triggerall = power >= 2000 
;triggerall = (command = "qcbf2p")
triggerall = cond(facing = 1,  NumExplod(90032506), NumExplod(90032404))
triggerall = (cond(NumExplod(90000200), 1, 0) + cond(NumExplod(90000210), 1, 0) + cond(NumExplod(90000220), 1, 0) >= 2) || (cond(NumExplod(90000205), 1, 0) + cond(NumExplod(90000215), 1, 0) + cond(NumExplod(90000225), 1, 0) >= 2)
triggerall = statetype = A  && !WinKo
triggerall = !NumHelper(2150) ;No Vice Shot										   
triggerall = !NumHelper(2450) ;No Vice Shot
trigger1 = Ctrl
trigger2 = (StateNo = 600) || (StateNo = 610) || (StateNo = 620)
trigger2 = MoveContact
trigger3 = (StateNo = 630) || (StateNo = 640) || (StateNo = 650) || (StateNo = 655)
trigger3 = MoveContact
value = 2403


