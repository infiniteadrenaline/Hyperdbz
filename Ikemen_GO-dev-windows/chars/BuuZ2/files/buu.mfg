;____________________________________________________________________________
; AI
[State -1, AI Guard]
type= changestate
triggerall= AILevel>0 && numenemy
triggerall= !NumHelper(999916)  ;No EMO
triggerall= roundstate=2 && inguarddist
triggerall= statetype!=A || p2statetype=A
triggerall= (ctrl || (StateNo = [100,101])) && (stateno!=[120,155])&& !(enemynear,ctrl)
trigger1= random < 64*(AIlevel ** 2 / 64.0) && (enemynear,hitdefattr=SCA,NA)
trigger2= random < 128*(AIlevel ** 2 / 64.0) && (enemynear,hitdefattr=SCA,SA)
trigger3= random < 192*(AIlevel ** 2 / 64.0) && (enemynear,hitdefattr=SCA,HA)
value=120
; AI
[State -1, AI EMO Guard]
type= changestate
triggerall= AILevel>0 && numenemy
triggerall= NumHelper(999916)  ;EMO
triggerall= roundstate=2 && inguarddist
triggerall= statetype!=A || p2statetype=A
triggerall= (ctrl || (StateNo = [100,101]))&& (stateno!=[120,155])&& !(enemynear,ctrl)
trigger1= random < 32*(AIlevel ** 2 / 64.0) && (enemynear,hitdefattr=SCA,NA)
trigger2= random < 64*(AIlevel ** 2 / 64.0) && (enemynear,hitdefattr=SCA,SA)
trigger3= random < 86*(AIlevel ** 2 / 64.0) && (enemynear,hitdefattr=SCA,HA)
value=120

; AI Air Taunt
[State -1, AI Air Taunt]
type = ChangeState
triggerall = AILevel>0 && AILevel != 8 && numenemy && roundstate=2 && StateType = A
triggerall =(p2bodydist x>=100) && (p2bodydist y>=40)&& P2statetype != A && P2statetype != L
triggerall = P2movetype=A
triggerall = var(4)=0 ;limiter
triggerall = stateno!=695
trigger1 = ctrl && random < 150/(AIlevel ** 2 / 64.0)
value = 695

;AI Run Backward
[State -1, AI Run Backward]
type=changestate
triggerall= AILevel>0 && numenemy
triggerall= roundstate=2 && statetype=S
triggerall= ctrl && (stateno!=[100,106])
trigger1= (enemynear,movetype=A) && backedgedist>=80 && (p2bodydist x=[80,120]) && (enemynear,vel x)
trigger1= random<cond((enemynear,hitdefattr=SC,AT),100,50)
trigger2= (p2bodydist x=[0,80]) && backedgebodydist>=80
trigger2= enemynear,stateno=5120 && enemynear,animtime=-3 && random<300*((AIlevel**2)/64.0)
value=105

;AI Meltdown
[State -1, AI Meltdown]
type = ChangeState
triggerall= AILevel>0 && numenemy && roundstate = 2 && statetype != A
trigger1 = ctrl && random < 250*(AIlevel ** 2 / 64.0)
trigger1 = p2bodydist x>=120 && (P2movetype=A || enemynear,movetype=A)
trigger2 = ((stateno = 200) || (stateno = 205) || (stateno = 210 || (stateno = 211)) || (stateno = 220))
trigger2 = ((stateno = 230) || (stateno = 240) || (stateno = 245) || (stateno = 250) || (stateno = 255))
trigger2 = ((stateno = 400) || (stateno = 410) || (stateno = 420))
trigger2 = ((stateno = 430) || (stateno = 440) || (stateno = 450))
trigger2 = Movehit && random < 50*(AIlevel ** 2 / 64.0)
trigger3 = stateno = 100 || stateno = 101
trigger3 = random < 50*(AIlevel ** 2 / 64.0)
value = 300

;AI Air Meltdown
[State -1, AI Air Meltdown]
type = ChangeState
triggerall= AILevel>0 && numenemy && roundstate = 2 && statetype = A
trigger1 = ctrl && random < 250*(AIlevel ** 2 / 64.0)
trigger1 = p2bodydist x>=120 && (P2movetype=A || enemynear,movetype=A)
trigger2 = (stateno = [600,654]) 
trigger2 = Movehit && random < 50*(AIlevel ** 2 / 64.0)
