;===========================================================================
; STANCE (tail motion sound)
;===========================================================================

[Statedef 0]
type = S
physics = S
sprpriority = 0
anim = 0 ;18200

[State 0, RemapPal]
type = RemapPal
trigger1 = (PrevStateNo = [714, 715]) || PrevStateNo = 718
source = 1, 1
dest = 1, var(58)
persistent = 0

[State 0, StopSnd]
type = StopSnd
trigger1 = (PrevStateNo = [191, 194]) || PrevStateNo = 711 || (PrevStateNo = [713, 716]) || PrevStateNo = 718
channel = 0

[State 0, StopSnd]
type = StopSnd
trigger1 = PrevStateNo = 716
channel = 10

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = fvar(38)=1
flag = invisible
flag2 = nobardisplay

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, Explod: Red Hands VFX (Standing)]
type = Explod
trigger1 = fvar(38)!=1
trigger1 = !NumExplod(3110) && var(51) && Anim = 0
anim = cond(var(51) = 1, 3110, 3115)
ID = 3110
bindTime = -1
removeTime = -1
removeOnGetHit = 1
pos = 0, 0
scale = 1, 1
posType = P1
sprPriority = 1

[State 0, Explod: Blue Hands VFX (Standing)]
type = Explod
trigger1 = fvar(38)!=1
trigger1 = !NumExplod(3120) && var(52) && Anim = 0
anim = cond(var(51) = 1, 3120, 3125)
ID = 3120
bindTime = -1
removeTime = -1
removeOnGetHit = 1
pos = 0, 0
scale = 1, 1
posType = P1
sprPriority = 1

[State 0, Explod: Red Hands VFX (Turning)]
type = Explod
trigger1 = fvar(38)!=1
trigger1 = !NumExplod(4) && var(51) && Anim = 5
anim = 4
ID = 4
bindTime = -1
removeTime = -1
removeOnGetHit = 1
pos = -14, -60
scale = 1, 1
posType = P1
sprPriority = 1

[State 0, Explod: Blue Hands VFX (Turning)]
type = Explod
trigger1 = fvar(38)!=1
trigger1 = !NumExplod(8) && var(52) && Anim = 5
anim = 8
ID = 8
bindTime = -1
removeTime = -1
removeOnGetHit = 1
pos = 0, -62
scale = 1, 1
posType = P1
sprPriority = 1

[State 50, ModifyExplod]
type = ModifyExplod
trigger1 = NumExplod(4) && Anim = 5 && AnimElemTime(2) >= 0
ID = 4
pos = 0, -62
PosType = P1

[State 50, ModifyExplod]
type = ModifyExplod
trigger1 = NumExplod(8) && Anim = 5 && AnimElemTime(2) >= 0
ID = 8
pos = 14, -60
PosType = P1

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0
[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
;---------------------------------------------------------------------------
; Stand to Crouch
[StateDef 10]
type = C
physics = C
moveType = I
sprPriority = 0

[State 10, Reversed Commands: change to jumping]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holddown"
value = 40

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10
value = 10

[State 10, Explod: Red Hands VFX (Standing to Crouching)]
type = Explod
trigger1 = !NumExplod(3196) && var(51) && Anim = 10
anim = 3196
ID = 3196
bindTime = -1
removeTime = -1
removeOnGetHit = 1
pos = 0, 0
scale = 1, 1
posType = P1
sprPriority = 1

[State 10, Explod: Blue Hands VFX (Standing to Crouching)]
type = Explod
trigger1 = !NumExplod(3197) && var(52) && Anim = 10
anim = 3197
ID = 3197
bindTime = -1
removeTime = -1
removeOnGetHit = 1
pos = 0, 0
scale = 1, 1
posType = P1
sprPriority = 1

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;Crouching
[StateDef 11]
type = C
physics = C
moveType = I
anim = 11

sprPriority = 0

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = AnimElemTime(2) < 0
trigger1 = Time >= 60 && Time % 100 = 0 && Random < 700
value = 11
elem = 2

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 6 && !AnimTime
