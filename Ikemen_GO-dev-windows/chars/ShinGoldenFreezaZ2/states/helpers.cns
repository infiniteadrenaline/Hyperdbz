trigger1 = 1 || var(0) := root,id
;var(1)/var(2) are destruct/hide condtion checks
trigger1 = 1 || var(3) := cond(teamside = 1,1,-1) ;Facing
;var(4) is a temp var containing the current LVL
;var(5) is a temp var checking if the root exists
;var(6) is a temp var storing how many uses of Combo Breaker remain
trigger1 = 1 || var(6) := 2
trigger1 = 1 || fvar(1) := cond(teamside = 1, 36,315) ;Base X Pos
trigger1 = 1 || fvar(2) := 224 ;Base Y Pos
trigger1 = 1 || fvar(3) := 0.5 ;Scale
trigger1 = 1 || fvar(4) := floor(fvar(1) - (124*(teamside = 2))) ;Only Icon adjust for P2
;fvar(5) is a temp var containing Red Bar X Scale
trigger1 = 1 || fvar(6) := fvar(1)+cond(teamside = 1, -8,-29); Bars X Axis
;fvar(7) is a temp var containing Blue Bar X Scale
;Calculate new values
;trigger1 = 1 || fvar(1) := fvar(1)*fvar(3)
;trigger1 = 1 || fvar(2) := fvar(2)*fvar(3)
persistent = 0

[state reset combo breaker]
type = varset
trigger1 = roundstate = 1
var(6) = 2

[State Steal Bomb Timer]
type = varset
triggerall = playeridexist(var(0))
trigger1 = playerid(var(0)),numhelper(3416)
fvar(7) = playerid(var(0)),cond(1,helper(3416),var(0),0)

;[State 0, VarSet]
;type = VarSet
;trigger1 = 1
;fvar(7) = root, fvar(16)

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "fvar(7) = %d  vel x = %f"
params = fvar(7),vel x



[State NoCamMove]
type = screenbound
;trigger1 = 1 ||
trigger1 = cond(playeridexist(var(0)),1||fvar(5) := (playerid(var(0)),var(50)),0) ;No Sadism Gauge
movecamera = 0,0
value = 0
ignorehitpause = 1

;[State Calc Valuea]
;type = null
;trigger1 = cond(playeridexist(var(0)), var(5) := 1,1 || var(5) := 0)

[State Destruction conditions]
type = varset
trigger1 = !playeridexist(var(0)) ;Root no longer exists
trigger2 = cond(playeridexist(var(0)),!(playerid(var(0)),var(50)),0) ;No Sadism Gauge
var(1) = 1
[State reset hide]
type = varset
trigger1 = var(2)
var(2) = 0
[State Hide conditions] ;Mainly for HDBZs Cinematic Indicator via Explod
type = varset
trigger1 = cond(playeridexist(var(0)),playerid(var(0)),numexplod(991901),0) ;Root no longer exists
trigger2 = cond(numenemy,enemy,numexplod(991901),0)
var(2) = 1

[State LVL Icon]
type = explod
;triggerall = cond(playeridexist(var(0)),var(4) = floor(playerid(var(0)),var(50)/300),0)
triggerall = var(1)+var(2) = 0
trigger1 = !numexplod(stateno)
id = stateno
anim = 29866+floor(playerid(var(0)),var(50)/300)
pos = floor(fvar(4)),floor(fvar(2))+1
;pos = floor(fvar(1)),floor(fvar(2))
postype = left
bindtime = -1
;facing = var(3)
removetime = -1
sprpriority = 21
scale = fvar(3),fvar(3)
ontop = 1

[State Red Bar]
type = explod
triggerall = var(1)+var(2) = 0
trigger1 = !numexplod(stateno+2)
id = stateno+2
anim = 29862
pos = floor(fvar(6)),floor(fvar(2))
postype = left
bindtime = -1
facing = var(3)
removetime = -1
sprpriority = 20
;scale = (playerid(var(0)),var(50)/300) * fvar(3),fvar(3)
scale = (fvar(5)/900) * fvar(3),fvar(3)
ontop = 1
[State Blue Bar]
type = explod
triggerall = var(1)+var(2) = 0
trigger1 = !numexplod(stateno+5)
id = stateno+5
anim = 29861
pos = floor(fvar(6)),floor(fvar(2))
postype = left
bindtime = -1
facing = var(3)
removetime = -1
sprpriority = 20
;scale = (playerid(var(0)),var(50)/300) * fvar(3),fvar(3)
scale = (fvar(7)/361) * fvar(3),fvar(3)
ontop = 1


[State Remove/Hide Icon]
type = removeexplod
triggerall = numexplod(stateno)
trigger1 = var(1)+var(2) != 0
trigger2 = cond(playeridexist(var(0)),floor(playerid(var(0)),var(50)/300) != var(4),0)
trigger2 = var(4) := floor(playerid(var(0)),var(50)/300)

id = stateno
[State Remove/Hide Gauge]
type = removeexplod
triggerall = numexplod(stateno+1)
trigger1 = var(1)+var(2) != 0
id = stateno+1
[State Remove/Hide Red Bar]
type = removeexplod
triggerall = numexplod(stateno+2)
trigger1 = var(1)+var(2) != 0
id = stateno+2
[State Remove/Hide F1]
type = removeexplod
triggerall = numexplod(stateno+3)
trigger1 = var(1)+var(2) != 0
trigger2 = var(6) < 2
id = stateno+3
[State Remove/Hide F2]
type = removeexplod
triggerall = numexplod(stateno+4)
trigger1 = var(1)+var(2) != 0
trigger2 = var(6) < 1
id = stateno+4
[State Remove/Hide Blue Bar]
type = removeexplod
triggerall = numexplod(stateno+5)
trigger1 = var(1)+var(2) != 0
trigger2 = root, MoveType = H
trigger2 = root, StateNo != [120,155]
id = stateno+5

[State Scale Red Bar]
type = modifyexplod
triggerall = numexplod(stateno+2) && fvar(5)
trigger1 = playeridexist(var(0))
id = stateno+2
scale = (fvar(5)/900),1;fvar(3)
;scale = time/30,fvar(3)
[State Scale Blue Bar]
type = modifyexplod
triggerall = numexplod(stateno+5) && fvar(7)
trigger1 = playeridexist(var(0))
id = stateno+5
scale = (fvar(7)/361),1;fvar(3)
;scale = time/30,fvar(3)

[State Gauge]
type = explod
triggerall = var(1)+var(2) = 0
trigger1 = !numexplod(stateno+1)
id = stateno+1
anim = 29860+(5*(teamside=2))
pos = floor(fvar(1)),floor(fvar(2))
postype = left
bindtime = -1
;facing = var(3)
removetime = -1
sprpriority = 22
;scale = fvar(3),fvar(3)
ontop = 1

[State F1]
type = explod
triggerall = var(6) >= 1
triggerall = var(1)+var(2) = 0
trigger1 = !numexplod(stateno+3)
id = stateno+3
anim = 29863
pos = floor(fvar(1)),floor(fvar(2))
postype = left
bindtime = -1
;facing = var(3)
removetime = -1
sprpriority = 22
;scale = fvar(3),fvar(3)
ontop = 1

[State F2]
type = explod
;triggerall = var(6) = 2
triggerall = var(1)+var(2) = 0
trigger1 = !numexplod(stateno+4)
id = stateno+4
anim = 29864
pos = floor(fvar(1)),floor(fvar(2))
postype = left
bindtime = -1
;facing = var(3)
removetime = -1
sprpriority = 22
;scale = fvar(3),fvar(3)
ontop = 1

[state destroyself]
type = destroyself
trigger1 = var(1)


