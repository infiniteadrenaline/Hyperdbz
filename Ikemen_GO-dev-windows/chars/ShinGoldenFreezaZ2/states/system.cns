; <<<<< WINPOSES >>>>>
; Win Pose Decider : 180
; Win Pose 1 - Bow : 181
; Win Pose 2 - Giggle : 182
; Win Pose 3 - Party : 183
; Win Pose 4 - 100% Power : 184
; Win Pose 5 - Super Nova: 185
; Win Pose 6 - The Emperor Strikes Back : 186
; Win Pose 7 - Single Dragon Ball : 187 (NOT USED)
; Win Pose 8 - Low Health : 188
; Win Pose 9 - Flames : 189
; Arcade Win Pose 1 - Rising Dragon Balls : 6800
; Arcade Win Pose 2 - Spinning Dragon Balls : 6801
;===========================================================================

; WIN STATE DECIDER
[StateDef 180]
type = S

[State 0, VarAdd]
type = VarAdd
trigger1 = MatchOver
fvar(39) = 1

[State 3025, Dragon Ball from opponent]
type = helper
triggerall = !AILEVEL
triggerall = numenemy
triggerall = !((ishometeam = 1)&& (teamside= 1)) 
triggerall = !time
triggerall = MatchOver && !numhelper(18045)
trigger1 = MatchNo = 2
trigger2 = MatchNo = 3
trigger3 = MatchNo = 5
trigger4 = MatchNo = 6
trigger5 = MatchNo = 8
trigger6 = MatchNo = 11
trigger7 = MatchNo = 12
helpertype = normal
stateno = 18045
ID = 18045
name = "Dragon Ball"
postype = p2
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 180, Finisher 3 Win Pose]
type = ChangeState
trigger1 = !Time && !fvar(24) && PrevStateNo = 6805
value = 6805

[State 180, Finisher 0 Win Pose]
type = ChangeState
trigger1 = fvar(38) = 1
value = 2203

[State 180, Arcade Win Pose]
type = ChangeState
trigger1 = !Time && fvar(24)
value = 186

[State 180, Arcade Win Pose]
type = null;ChangeState
trigger1 = !Time && var(25) = 9
value = 6800 + (Random & 2)

[State 180, Win Pose Selector 1]
type = ChangeState
trigger1 = !Time && (command = "holda" || command = "holdb" || command = "holdc")
value = ifElse(command = "holda", 186, ifElse(command = "holdb", 185, 184))

[State 180, Win Pose Selector 2]
type = ChangeState
trigger1 = !Time && (command = "holdx" || command = "holdy" || command = "holdz")
value = ifElse(command = "holdx", 183, ifElse(command = "holdy", 182, 181))

[State 180, Generic Win Pose + Flames + Low Health]
type = ChangeState
trigger1 = !Time && var(51) && var(52) && Life <= 120
value = ifElse(Random < 333, 189, ifElse(Random < 333, 188, (181 + (Random % 6))))

[State 180, Generic Win Pose + Flames]
type = ChangeState
trigger1 = !Time && var(51) && var(52)
value = ifElse(Random < 333, 189, (181 + (Random % 6)))

[State 180, Generic Win Pose + Low Health]
type = ChangeState
trigger1 = !Time && Life <= 120
value = ifElse(Random < 333, 188, (181 + (Random % 6)))

[State 190, VarSet]
type = VarSet
trigger1 = enemy,AILevel=0
trigger1 = random < 333
var(25) = 10

[State 180, Generic Win Pose]
type = ChangeState
trigger1 = !Time
value = cond(random < 333 && var(25) = 10,6800 + (Random%2), 181 + (Random % 6))


