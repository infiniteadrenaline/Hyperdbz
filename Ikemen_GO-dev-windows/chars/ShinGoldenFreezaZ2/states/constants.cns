[Data]
life = 1100
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 15
airjuggle = 15
sparkno = 2	
guard.sparkno = -1
KO.echo = 0	
volumescale = 150
IntPersistIndex = 49
FloatPersistIndex = 20

[Size]
xscale = 1				;Horizontal scaling factor.
yscale = 1				;Vertical scaling factor.
ground.back = 20		;Player width (back, ground)
ground.front = 20		;Player width (front, ground)
air.back = 12			;Player width (back, air)
air.front = 12			;Player width (front, air)
height = 60				;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = -3,-65   ;-5, -90		;Approximate position of head
mid.pos = -1,-41   ;-5, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.0			;Walk forward
walk.back = -2.0		;Walk backward
run.fwd  = 6, 0			;Run forward (x, y)
run.back = -9,-2	;Hop backward (x, y)
jump.neu = 0,-9.5;-10		;Neutral jumping velocity (x, y)
jump.back = -3.25		;Jump back Speed (x, y)
jump.fwd = 3.25			;Jump forward Speed (x, y)
runjump.back = -7.5,-8.5		;Running jump speeds (opt)
runjump.fwd = 6,-8.5	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0			;Number of air jumps allowed (opt)
airjump.height = 35		;Minimum distance from ground before you can air jump (opt)
yaccel = .40;.51        	;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .85	;Friction coefficient when crouching

[Quotes]
victory50 = "I'll make sure no more of your breeding can raise to challenge me."
victory51 = "Trash like you should remain down. Kneel."
victory52 = "The thing you should be asking is not how to beat me, but how to make yourself useful to me."
victory53 = "I fulfill my promises, and I promised you would be wishing for the release of death."
victory54 = "This oppression shall not stand, I'm the one that does the oppressing around here!!"
victory55 = "Don't worry, my empire will need people to clean the gutters. "
victory57 = "I'm learning to balance this.. that was a smidgen of my speed pushing through and you were left speechless, wonderful."
victory58 = "In anger I've used all my power through sheer strength before, but I know better now... I can take my time peeling trash like you apart."
victory59 = "This wicked bloodline has served me well, you are another victim of my empire of terror."
victory60 = "If you make an effort, don't be half hearted about it, it won't go well."
victory61 = "I'm eager to see the full extent of your power... that couldn't have been it."
victory62 = "Destruction turned sublime, I'll set the universes aflame."
victory63 = "My flames will use you as kindle."
victory64 = "The Gods might sit on their thrones for now, but things won't go their way forever..."
victory65 = "Your intent is meaningless to me. I don't care for the aspirations of corpses."
victory67 = "Even those bowing to me shall be reduced to cinder."
victory68 = "Divine transformation... A surge, a hole, a galaxy. Negligence, a trap, parasites."
victory69 = "It's too late for regrets, die screaming."
victory70 = "Amusing... You can stay by my side a few more hours, as a water boy or something..."
victory71 = "The world brought me pain, and I made gold out of it."
victory72 = "They don't give you gold medals for beating somebody. They give you gold medals for beating everybody."
victory73 = "You're rushing me. Stop dying so easily. You are sapping the fun out of this."
victory74 = "You are shiny, but you are definitely not Gold."
victory75 = "I have the gold, I make the rules."
victory76 = "I can't stand the sight of your pleading eyes, rip them off."
victory77 = "You've made me improve a bit, seems like cannon fodder will always have its uses."
victory78 = "I could give you some of my own Ki to continue this fight, but I feel like hearing you bleed out instead."
victory79 = "Y-you?! You hurt me? ME? YOU ACTUALLY DARE TO HURT ME?!"
victory80 = "I had to train, actually train, to be this strong! Disgusting."
victory81 = "I gave you a few years of head start, more than fair."
victory82 = "I've been to hell, you won't get me there again!!"
victory83 = "I'm no monster, I will let you live long enough to see everyone you love die."
victory84 = "You can cry. You can run. You can beg. You can't escape."
victory85 = "You have pretty lips, use them to kiss my feet."
victory86 = "Delightful. The way you scream is just delightful."
victory87 = "I see, the training has given me... some ample results. You should've tried some of it too."
victory88 = "This is convenient, the trash is seeking me out to die."
victory89 = "You little... I will rip your spine and stuff it down your throat!"
victory90 = "Behold your Golden God! I am untethered and my rage knows no bounds!"
victory91 = "No one is safe. Maybe... not even the gods."
victory92 = "If those filthy monkeys hadn't felled me I would never have unlocked this power. The irony infuriates me."
victory93 = "I've developed a new technique for this power... It's called training. You ever heard about it?"
victory94 = "How rude of me, my fist slipped right into your chest."
victory95 = "Fascist, tyrant, call me whatever you want, as long as it's through wails and death rattles."
victory96 = "I've focused and meditated, my mind nothing but going over the many ways I would cut you to pieces... and now, time to put it into practice."
victory97 = "Now, lets crack you open and see what makes you tick."
victory98 = "I can taste... my blood. I've decided death is too good for you, I'll be vivisecting you now."
victory99 = "Stare straight into my eyes. I'm going to burn your head clean off and I don't want to miss."