trigger2 = AILevel
trigger2 = NumHelper(1050)
trigger2 = (Helper(1050), MoveContact)  && Random < (500 * (AILevel ** 2 / 64.0))
trigger3 = AILevel
trigger3 = Random < (200 * (AILevel ** 2 / 64.0))
