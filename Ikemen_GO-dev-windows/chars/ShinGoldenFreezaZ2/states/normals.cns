guard.velocity = -2
guard.ctrltime = 16
air.type = High	
air.velocity = -2,-2
air.hittime = 12
air.animtype = back
airguard.velocity = -2,-1.3
ground.cornerpush.veloff = 0
air.cornerPush.velOff = 0
air.fall = 1
fall.recover = 1
fall.recoverTime = 120
forceStand = 1
getpower= 35,35
givepower = 20,20 ;35,20 ;35
yaccel = 0.5

[State 1600, Last hit]
