air.hittime = 12
air.animtype = back
airguard.velocity = -6,-1.3
ground.cornerpush.veloff = -8
air.cornerPush.velOff = 0
air.fall = 1
fall.recover = 1
fall.recoverTime = 120
forceStand = 1
getpower= 35,35
givepower = 20,20 ;35,20 ;35
