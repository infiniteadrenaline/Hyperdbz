triggerall = Roundstate = [2,3]
;triggerall = (((command = "qcfa") || (command = "qcfb") || (command = "qcfc")) && NumExplod(20)=0) || (((command = "qcba") || (command = "qcbb") || (command = "qcbc")) && NumExplod(20)=1)
triggerall = stateno!=[3000,3021]
triggerall = ((ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90010104)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90010006)))
triggerall =  NumExplod(90000250) || NumExplod(90000255) 
triggerall =!WinKo
triggerall = (var(50)>0&&var(51)=1&&var(52)=1) || (var(50)>0&&var(51)=2&&var(52)=2)
trigger1 = animelemtime(6)>0&&animelemtime(8)<0 
trigger1 = movehit
value = cond(var(51)=0&&var(52)=0,3000,3000+ (Var(51) * 10) + (Var(52)))

