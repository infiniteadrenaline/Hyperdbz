; SSJ3 WINPOSE 5 - Pinnochio
[Statedef 3633]
type = S
ctrl = 0
anim = 1890
velset = 0,0
sprpriority = 1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State set Voice]
type = null
triggerall = animelem = 2
trigger1 = 1 || var(9) := random%3
trigger1 = 1 || fvar(6) := floor(time)
;Set laugh timer
trigger1 = 1 || cond(var(9) = 0, fvar(6) := fvar(6) + 70,1)
trigger1 = 1 || cond(var(9) = 1, fvar(6) := fvar(6) + 100,1)
trigger1 = 1 || cond(var(9) = 2, fvar(6) := fvar(6) + 30,1)
persistent = 0

[State Swing SND]
type = PlaySnd
trigger1= animelem = 3
value = 0, 1
channel = 1
persistent = 0

[State laugh]
type = playsnd
trigger1 = animelem = 2
value = s196,7+var(9);(random%3)
channel = 12
persistent = 0

[State hold when laugh ends]
type = changeanim
triggerall = fvar(6)
trigger1 = time >= fvar(6)
value = anim
elem = 4

[state 181, 1]
type = assertspecial
trigger1 = time < 400
flag = roundnotover

