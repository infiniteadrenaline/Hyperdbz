trigger2 = P2StateType != A
trigger2 = Cond(AILevel <5,(Random<100*((AIlevel**2)/64.0)),(Random<200*((AIlevel**2)/64.0)))
trigger2 = P2StateType != L
value = 1090
ctrl = 0

