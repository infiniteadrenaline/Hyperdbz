;================================
; Special and EX moves
;================================

;===========================================================================
;---------------------------------------------------------------
;Hero Stance
[Statedef 1000]
type    = U
movetype= I
physics = N
anim = Cond(StateType = A,1003,1000)
ctrl = 0
poweradd = 0
velset = 0,0
facep2 = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = StateType = S
trigger2 = Pos Y >=0
statetype = S
physics = S

[State set vel]
type = velset
trigger1 = pos y >= -vel y
y = 0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = StateType != A
value = 1000
elem = AnimElemNo(0)
persistent = 0

[State 0, VarAdd]
type = VarAdd
trigger1 = Var(50)>0
trigger1 = !Time
trigger1 = P2MoveType = H
var(52) = 40

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = 0,50
channel = -1

[State 0, Width]
type = Width
trigger1 = 1
value = 0,30

[State 0, VarSet]
type = VarSet
trigger1 = !Time
var(9) = 0

[State 0, VarSet]
type = VarSet
triggerall = Time >1
trigger1 = !AILevel
trigger1 = Var(9) = 0
trigger1 = command = "x"
var(9) = 1
[State 0, VarSet]
type = VarSet
triggerall = Time >1
trigger1 = !AILevel
trigger1 = Var(9) = 0
trigger1 = command = "y"
var(9) = 2
[State 0, VarSet]
type = VarSet
triggerall = Time >1
trigger1 = !AILevel
trigger1 = Var(9) = 0
trigger1 = command = "z"
var(9) = 3
[State 0, VarSet]
type = VarSet
triggerall = Time >1
triggerall = Power >= 500 || Var(51) >= 500
trigger1 = !AILevel
trigger1 = command = "y" && command = "x" || command = "z" && command = "x" 
var(9) = 4
[State 0, VarSet]
type = VarSet
triggerall = Time >1
triggerall = Power >= 500 || Var(51) >= 500
trigger1 = !AILevel
trigger1 = command = "z" && command = "y"
var(9) = 5

[State 1000, Power]
type = PowerAdd
;triggerall = P2MoveType != H
triggerall = ((Anim = 1000)||(Anim = 1003)) && (power < 3000)
triggerall = Time >= 8
trigger1 = Var(50)<=0
trigger2 = Var(50)>0
trigger2 = Var(52)>=3000
value =  1
[State 0, VarAdd]
type = VarAdd
triggerall = ((Anim = 1000)||(Anim = 1003))  && (Var(50) >0)
triggerall = Time >= 8
trigger1 = Var(52)>=3000
;trigger1 = P2MoveType != H
trigger1 = Var(51) < 3000 && Power >=3000
var(51) = Cond((NumHelper(3310)||NumHelper(3410)||NumHelper(1110)||NumHelper(1116)),5 + ((time-8)/200),5 + ((time-8)/100))

[State 0, VarAdd]
type = VarAdd
triggerall = ((Anim = 1000)||(Anim = 1003))  && (Var(50) >0)
triggerall = Time >= 8
trigger1 = Var(52)<3000
;trigger1 = P2MoveType != H
var(52) = Cond((NumHelper(3310)||NumHelper(3410)||NumHelper(1110)||NumHelper(1116)),1 + ((time-8)/200),5 + ((time-8)/100))

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = 1000,0 + random%5
channel = 0

;Wolf Fang Fist Slasher
[State 0, ChangeState]
type = ChangeState
triggerall = Power >= 500 || Var(51) >= 500
triggerall = Time >= 8
trigger1 = !AILEVEL
trigger1 = Var(9) = 4 ;|| (ifElse(NumExplod(90000200), 1, 0) + ifElse(NumExplod(90000210), 1, 0) + ifElse(NumExplod(90000220), 1, 0) >= 2) || (ifElse(NumExplod(90000205), 1, 0) + ifElse(NumExplod(90000215), 1, 0) + ifElse(NumExplod(90000225), 1, 0) >= 2)
trigger2 = AILEVEL
trigger2 = P2StateType != L
trigger2 = P2BodyDist X = [0,50]
trigger2 = P2MoveType = H && (P2StateNo != [120,155]) || P2MoveType = A
trigger2 = Cond(AILevel <5,(Random<100*((AIlevel**2)/64.0)),(Random<200*((AIlevel**2)/64.0)))
trigger3 = AILEVEL
trigger3 = NumHelper(3310)
trigger3 = helper(3310), StateNo = 3312
value = 1080
ctrl = 0

;cancel
[State 0, ChangeState]
type = ChangeState
triggerall = !AILEVEL
triggerall = Cond((P2StateNo = [120,155]),Time >= 16,Time >= 8)
triggerall = ((command!="x" && command!="y" && command!="z") || (Var(11)=1&&(command!="rlsx" && command!="rlsy" && command!="rlsz")))
trigger1 = ((command="a") || (Var(11)=1&&(command="rlsa")))
trigger2 = ((command="b") || (Var(11)=1&&(command="rlsb")))
trigger3 = ((command="c") || (Var(11)=1&&(command="rlsc")))
trigger4 = Win || Lose || DrawGame
value = 1001
ctrl = 0
[State 0, ChangeState]
type = ChangeState
triggerall = Cond((P2StateNo = [120,155]),Time >= 16,Time >= 8)
trigger1 = Win || Lose || DrawGame
value = 1001
ctrl = 0

[State 0, VarRandom]
type = VarRandom
trigger1 = AILEVEL
trigger1 = !Time
v = 37
range = 0,100

;jump cancel
[State 3, ChangeState]
type = ChangeState
triggerall = statetype = S
triggerall = (Anim = 1000)
triggerall = Cond((P2StateNo = [120,155]),Time >= 16,Time >= 8)
trigger1 = !AILEVEL
trigger1 = NumExplod(90000008) || NumExplod(90000007) || NumExplod(90000009)
trigger2 = AILEVEL>0
trigger2 = (Random<200*((AIlevel**2)/64.0))
trigger2 = (P2StateNo = [120,155])
trigger3 = AILEVEL>0
trigger3 = (Random<20*((AIlevel**2)/64.0))
trigger3 = P2BodyDist X > 140
trigger4 = AILEVEL>0
trigger4 = (Random<40*((AIlevel**2)/64.0))
trigger4 = P2BodyDist X < 0
trigger5 = AILEVEL>0
trigger5 = NumHelper(3410)
trigger5 = helper(3410), StateNo = 3420
trigger6 = AILEVEL>0
trigger6 = NumHelper(3310)
trigger6 = helper(3310), StateNo = 3312
value = 10232
ctrl = 0

[State 0, ChangeState]
type =ChangeState
triggerall = AILEVEL
trigger1 = Cond((P2StateNo = [120,155]),Time >= 16,Time >= 68) + Var(37)
trigger1 = Cond(AILevel <5,(Random<100*((AIlevel**2)/64.0)),(Random<60*((AIlevel**2)/64.0)))
trigger2 = Cond((P2StateNo = [120,155]),Time >= 16,Time >= 8) 
trigger2 = Win || Lose || DrawGame
trigger3 = Cond((P2StateNo = [120,155]),Time >= 16,Time >= 38)
trigger3 = Cond(AILevel <5,(Random<200*((AIlevel**2)/64.0)),(Random<400*((AIlevel**2)/64.0)))
trigger3 = P2Dist X < 0
value = 1001
ctrl = 0

;Wolf Fang Fist Kicker
[State 0, ChangeState]
type = ChangeState
triggerall = Power >= 500 || Var(51) >= 500
triggerall = Time >= 8
trigger1 = !AILEVEL
trigger1 = Var(9) = 5 ;|| (ifElse(NumExplod(90000230), 1, 0) + ifElse(NumExplod(90000240), 1, 0) + ifElse(NumExplod(90000250), 1, 0) >= 2) || (ifElse(NumExplod(90000235), 1, 0) + ifElse(NumExplod(90000245), 1, 0) + ifElse(NumExplod(90000255), 1, 0) >= 2)
