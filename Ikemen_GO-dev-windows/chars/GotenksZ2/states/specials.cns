ignorehitpause = 1
;persistent =

[State 0, Offset]
type = null;Offset
triggerall = !ishelper
triggerall = Anim = 1003
trigger1 = time>=12;20
trigger1 = NumExplod(90000231) || NumExplod(90000241) || NumExplod(90000251)
