;Hyper DragonBall Z - The Husk of Humanity Stage

;by Alpha Proto & XGargoyle & Toni

[info]
name 		= "The Husk of Humanity (Nightmare)"
displayname	= "Zamasu no Mugen"
author		= "Alpha Proto & XGargoyle & Toni, oh my."

[camera]
startx 		= 0 ;-16
starty 		= 0
boundleft 	= -295 ;-208
boundright 	= 295 ;208
boundhigh 	= -300 ;-400
boundlow 	= 0
tension 	= 50
verticalfollow 	= .75
floortension 	= 90


;--------------------------------------------------------
[playerinfo]
p1startx = -70          ;starting x coordinates
p1starty = 0            ;starting y coordinates
p1startz = 0            ;starting z coordinates
p1facing = 1            ;direction player faces: 1=right, -1=left

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 ;left bound (x-movement)
rightbound =  1000 ;right bound
topbound  =  0   ;Top bound (z-movement)
botbound  =  0    ;Bottom bound

;--------------------------------------------------------
[scaling]
topz     = 0       ;top z-coordinate for scaling
botz     = 50      ;bottom z-coordinate for scaling
topscale = 1       ;scale to use at top
botscale = 1.2     ;scale to use at bottom

;--------------------------------------------------------
[bound]
screenleft = 30    ;dist from left of screen that player can move to
screenright = 30   ;right edge

;--------------------------------------------------------
[stageinfo]
 
zoffset = 220 ;-28 ;220
zoffsetlink = 2 ;10
autoturn = 1
resetbg = 0

;--------------------------------------------------------
[shadow]
intensity = 40
color = 20,10,10
fade.range = 0,-50
yscale = 0.4


;--------------------------------------------------------
[music]

bgmusic = sound/stages/hdbz_husk2.mp3
bgvolume = 100

;looping points for hdbz_husk2.mp3
bgmloopstart = 2107372
bgmloopend = 7027125

;========================================================
; main background definition
[bgdef]
spr = stages/hdbz_husk2.sff
debugbg = 0

;----------

[bg sky]
type = normal
spriteno = 0,0
start = 0, 0
tile = 1,1
delta = .01,.01
velocity = .05 ,0
sin.y = 4, 720

[bg sky 1]
type = normal
spriteno = 0,1
start = 0, 0
tile = 1,0
delta = .05,.05
velocity = .28 ,0
sin.y = 3, 720
mask = 1

[bg sky 2]
type = normal
spriteno = 0,2
start = 0, 0
tile = 1,0
delta = .1,.1
velocity = .3 ,0
sin.y = 3.3, 720
mask = 1

[bg moon glow]
type = dummy; anim
actionno = 1
spriteno = 1,0
start = 0, 250
delta = .05,.15
mask = 1

