[info]
name 		= "3rd Demon World"
displayname	= "Third Demon World"
author		= "Toni"

[camera]
startx 		= 0 ;-16
starty 		= 0
boundleft 	= -228
boundright 	= 228
boundhigh 	= -300 ;-400
boundlow 	= 0
tension 	= 50
verticalfollow 	= .75
floortension 	= 90


;--------------------------------------------------------
[playerinfo]
p1startx = -70          ;starting x coordinates
p1starty = 0            ;starting y coordinates
p1startz = 0            ;starting z coordinates
p1facing = 1            ;direction player faces: 1=right, -1=left

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 ;left bound (x-movement)
rightbound =  1000 ;right bound
topbound  =  0   ;Top bound (z-movement)
botbound  =  0    ;Bottom bound

;--------------------------------------------------------
[scaling]
topz     = 0       ;top z-coordinate for scaling
botz     = 50      ;bottom z-coordinate for scaling
topscale = 1       ;scale to use at top
botscale = 1.2     ;scale to use at bottom

;--------------------------------------------------------
[bound]
screenleft = 30    ;dist from left of screen that player can move to
screenright = 30   ;right edge

;--------------------------------------------------------
[stageinfo]
 
zoffset = 220
zoffsetlink = 2
autoturn = 1
resetbg = 0

;--------------------------------------------------------
[shadow]
intensity = 90
color = 15,37,30
fade.range = 0,-50
yscale = 0.3


;--------------------------------------------------------
[music]

;bgmusic = sound/Dragon Ball Z FighterZ OST rocky field at noon theme.mp3
bgmusic = sound/stages/hdbz_3rd-makai.mp3
bgvolume = 100


;========================================================
; main background definition
[bgdef]
spr = stages/hdbz_3rd-makai.sff
debugbg = 0

;----------

[bg sky]
type = normal
spriteno = 0,0
start = 0, 110
delta = .3,.3
layerno = 0

[bg islands]
type  = normal
spriteno = 5,0
start = -30, 102
delta = .35,.35
mask = 1

[bg warp-sama]
type = normal
spriteno = 60,0
start = 0, 110
delta = .3,.3
sin.y = 3, 1900
velocity = -.01, 0
tile = 1,0
tilespacing = 1000
mask = 1

[bg mountains b]
type  = normal
spriteno = 4,0
start = -30, 102
delta = .6,.6
mask = 1

[bg island 1]
type  = normal
spriteno = 4,1
start = -30, 102
delta = .6,.6
sin.y = 3, 600
mask = 1

[bg island 2]
type  = normal
spriteno = 4,2
start = -30, 102
delta = .6,.6
sin.y = -3, 600
mask = 1


[bg mountains f]
type  = normal
spriteno = 3,0
start = -40, 102
delta = .7,.7
mask = 1

[BG fog]
type  = normal
spriteno = 2,0
start = 200, 110
delta = 0.8, 0.8
mask = 1
layerno = 0
sin.x = 4, 820
velocity = -0.18, 0
tile = 1, 0
trans = addalpha
alpha = 40,256
id = 10

[bg ground]
type  = normal
spriteno = 1,0
start = 0, 102
delta = 1,1
mask = 1

[bg plant]
type  = normal
spriteno = 6,0
start = 0, 102
delta = 1,1
mask = 1

[bg tree]
type  = normal
spriteno = 6,1
start = 0, 102
delta = 1,1
mask = 1

[bg plane]
type  = normal
spriteno = 10,0
start = 0, 102
delta = 1,1
mask = 1



