[info]
name 		= "10th Anniversary"
displayname	= "HDBZ 10th Anniversary"
author		= "Pansh & Toni"

[camera]
startx 		= 0 ;-16
starty 		= 0
boundleft 	= -224 ;-208
boundright 	= 224 ;208
boundhigh 	= -240 ;-400
boundlow 	= 0
tension 	= 50
verticalfollow 	= .75
floortension 	= 90


;--------------------------------------------------------
[playerinfo]
p1startx = -70          ;starting x coordinates
p1starty = 0            ;starting y coordinates
p1startz = 0            ;starting z coordinates
p1facing = 1            ;direction player faces: 1=right, -1=left

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 ;left bound (x-movement)
rightbound =  1000 ;right bound
topbound  =  0   ;Top bound (z-movement)
botbound  =  0    ;Bottom bound

;--------------------------------------------------------
[scaling]
topz     = 0       ;top z-coordinate for scaling
botz     = 50      ;bottom z-coordinate for scaling
topscale = 1       ;scale to use at top
botscale = 1.2     ;scale to use at bottom

;--------------------------------------------------------
[bound]
screenleft = 30    ;dist from left of screen that player can move to
screenright = 30   ;right edge

;--------------------------------------------------------
[stageinfo]
 
zoffset = 220
zoffsetlink = 2
autoturn = 1
resetbg = 0

;--------------------------------------------------------
[shadow]
intensity = 120
color = 30,30,30
fade.range = 0,-50
yscale = 0.3


;--------------------------------------------------------
[music]

bgmusic = sound/stages/hdbz_10thanniversary.mp3 ; by DaMarcus
bgvolume = 100
bgmloopstart = 152724
bgmloopend = 4024743

;========================================================
; main background definition
[bgdef]
spr = stages/hdbz_10thanniversary.sff
debugbg = 0

;----------

[bg sky]
type  = normal
spriteno = 0,0
start = 12, 162
delta = .8,1
mask = 0

[bg buildings]
type  = normal
spriteno = 0,1
start = 28, 162
delta = .84,1
mask = 1

